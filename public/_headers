# Preview хостът на workers.dev е пълен дубликат на kova.bg — да не се
# индексира и да не се конкурира със собствения сайт. Вариант А (noindex
# вместо 301), за да остане адресът използваем за преглед на production
# build-а.
https://agency.radoslav-dodnikov.workers.dev/*
  X-Robots-Tag: noindex, nofollow

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  # `microphone=(self)`, а не `microphone=()`: гласовият агент иска микрофон и
  # при затворено разрешение браузърът му го отказва мълчаливо — приставката
  # се зарежда, изглежда наред и просто не чува нищо. Разрешението е само за
  # собствения адрес, а самият микрофон и без това не тръгва без изричното
  # „позволи“ на посетителя. Камерата и геолокацията остават затворени.
  Permissions-Policy: geolocation=(), microphone=(self), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed build output never changes — cache it hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Знакът на марката. Не е `immutable`, защото името му е фиксирано и няма
# хеш — при смяна на логото кешът трябва да изтече сам за седмица.
/brand/*
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800
