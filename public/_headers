# Preview хостът на workers.dev е пълен дубликат на kova.bg — да не се
# индексира и да не се конкурира със собствения сайт. Вариант А (noindex
# вместо 301), за да остане адресът използваем за преглед на production
# build-а.
https://agency.radoslav-dodnikov.workers.dev/*
  X-Robots-Tag: noindex, nofollow

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed build output never changes — cache it hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800
