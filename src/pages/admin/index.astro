---
/**
 * Панелът: предстоящите разговори и затвореното време.
 *
 * Едно екранче нарочно. Всичко, което се прави тук, се прави рядко — гледаш
 * кой е записан, отказваш нечий час, затваряш следобед. Раздели, търсачки и
 * страниране биха били повече работа за поддръжка, отколкото полза.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listBlocks, upcomingBookings } from '../../lib/booking.ts';
import { guardAdmin } from '../../lib/admin-auth.ts';
import { TIMEZONE } from '../../data/booking.mjs';
import { longDateLabel, zonedTimeLabel } from '../../lib/time.ts';

export const prerender = false;

const env = Astro.locals.runtime?.env ?? ({} as Env);
const gate = await guardAdmin(Astro.request.headers.get('cookie') ?? undefined, env);
const db = env.BOOKINGS;
const now = Date.now();
const error = Astro.url.searchParams.get('error') ?? '';

const bookings = gate.ok && db ? await upcomingBookings(db, now) : [];
const blocks = gate.ok && db ? await listBlocks(db, now) : [];

const sourceLabel: Record<string, string> = {
  web: 'сайта',
  agent: 'агента',
  admin: 'панела',
};

/** `datetime-local` иска местно време без зона — точно каквото човек пише. */
function localInputValue(offsetDays: number, hour: number): string {
  const target = new Date(now + offsetDays * 86_400_000);
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: TIMEZONE,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(target);
  return `${parts}T${String(hour).padStart(2, '0')}:00`;
}
---

<AdminLayout title="Панел">
  {
    !gate.ok && gate.reason === 'not_configured' && (
      <div class="card">
        <h1 class="h1">Панелът не е настроен.</h1>
        <p class="text">
          Липсва секретът <code>ADMIN_PASSWORD</code>. Докато го няма, панелът не се отваря на
          никого — това е нарочно. Задава се с:
        </p>
        <pre class="pre">npx wrangler secret put ADMIN_PASSWORD</pre>
      </div>
    )
  }

  {
    !gate.ok && gate.reason === 'signed_out' && (
      <div class="card card--narrow">
        <h1 class="h1">Вход</h1>
        {error && <p class="error">{error}</p>}
        <form method="POST" action="/admin/api/login" class="form">
          <label class="field">
            <span class="field__label">Парола</span>
            <input
              class="field__input"
              type="password"
              name="password"
              required
              autocomplete="current-password"
              autofocus
            />
          </label>
          <button class="btn btn--primary" type="submit">Влез</button>
        </form>
      </div>
    )
  }

  {
    gate.ok && (
      <>
        <header class="head">
          <h1 class="h1">Календар</h1>
          <form method="POST" action="/admin/api/logout">
            <button class="link" type="submit">
              Изход
            </button>
          </form>
        </header>

        {error && <p class="error">{error}</p>}

        {!db && (
          <div class="card">
            <p class="text">
              Няма връзка към базата. Провери <code>d1_databases</code> в{' '}
              <code>wrangler.jsonc</code>.
            </p>
          </div>
        )}

        <section class="section">
          <h2 class="h2">Предстоящи разговори ({bookings.length})</h2>

          {bookings.length === 0 ? (
            <p class="empty">Нищо запазено засега.</p>
          ) : (
            <ul class="list">
              {bookings.map((booking) => (
                <li class="row">
                  <div class="row__when">
                    <span class="row__day">
                      {longDateLabel(booking.start_utc, TIMEZONE, 'bg')}
                    </span>
                    <span class="row__time">
                      {`${zonedTimeLabel(booking.start_utc, TIMEZONE)}–${zonedTimeLabel(booking.start_utc + booking.minutes * 60000, TIMEZONE)}`}
                    </span>
                  </div>

                  <div class="row__who">
                    <span class="row__name">{booking.name}</span>
                    <span class="row__meta">
                      {booking.email || '—'}
                      {booking.phone ? ` · ${booking.phone}` : ''}
                      {` · през ${sourceLabel[booking.source] ?? booking.source}`}
                    </span>
                    {booking.note && <p class="row__note">{booking.note}</p>}
                  </div>

                  <form method="POST" action="/admin/api/cancel" class="row__action">
                    <input type="hidden" name="id" value={booking.id} />
                    <button class="link link--quiet" type="submit">
                      Откажи
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="section">
          <h2 class="h2">Затворено време</h2>
          <p class="text">
            Отпуска, лекар, вече зает следобед. Часовете тук изчезват от календара, без да са
            запазени от някого.
          </p>

          <form method="POST" action="/admin/api/block" class="blockForm">
            <label class="field">
              <span class="field__label">От</span>
              <input
                class="field__input"
                type="datetime-local"
                name="from"
                required
                value={localInputValue(1, 9)}
              />
            </label>
            <label class="field">
              <span class="field__label">До</span>
              <input
                class="field__input"
                type="datetime-local"
                name="to"
                required
                value={localInputValue(1, 18)}
              />
            </label>
            <label class="field field--wide">
              <span class="field__label">Причина (само за теб)</span>
              <input class="field__input" type="text" name="reason" maxlength="120" />
            </label>
            <button class="btn btn--primary" type="submit">Затвори времето</button>
          </form>

          {blocks.length > 0 && (
            <ul class="list list--tight">
              {blocks.map((block) => (
                <li class="row row--tight">
                  <div class="row__when">
                    <span class="row__day">{longDateLabel(block.start_utc, TIMEZONE, 'bg')}</span>
                    <span class="row__time">
                      {`${zonedTimeLabel(block.start_utc, TIMEZONE)}–${zonedTimeLabel(block.end_utc, TIMEZONE)}`}
                    </span>
                  </div>
                  <div class="row__who">
                    <span class="row__meta">{block.reason || 'без причина'}</span>
                  </div>
                  <form method="POST" action="/admin/api/unblock" class="row__action">
                    <input type="hidden" name="id" value={block.id} />
                    <button class="link link--quiet" type="submit">
                      Отвори пак
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    )
  }
</AdminLayout>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 34px;
  }

  .h1 {
    font-family: var(--font-display);
    font-size: clamp(26px, 4vw, 38px);
    letter-spacing: -0.035em;
    margin: 0;
  }

  .h2 {
    font-family: var(--font-display);
    font-size: 19px;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  .section + .section {
    margin-top: 52px;
    padding-top: 44px;
    border-top: 1px solid var(--line);
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: clamp(26px, 4vw, 38px);
  }

  .card--narrow {
    max-width: 420px;
    margin: 8vh auto 0;
  }

  .text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-body);
    margin: 14px 0 0;
  }

  .pre {
    background: var(--dark);
    color: var(--dark-ink);
    border-radius: 10px;
    padding: 14px 16px;
    font-size: 13.5px;
    overflow-x: auto;
    margin: 18px 0 0;
  }

  .error {
    background: var(--chip);
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    padding: 12px 16px;
    font-size: 15px;
    margin: 0 0 22px;
  }

  .empty {
    color: var(--ink-muted);
    font-size: 15.5px;
    margin: 0;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .list--tight {
    margin-top: 26px;
  }

  .row {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    gap: 20px;
    align-items: start;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 20px;
  }

  .row--tight {
    padding: 12px 20px;
  }

  .row__when {
    display: grid;
    gap: 2px;
  }

  .row__day {
    font-size: 15px;
    font-weight: 600;
    text-transform: capitalize;
  }

  .row__time {
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .row__who {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .row__name {
    font-size: 15.5px;
    font-weight: 600;
  }

  .row__meta {
    font-size: 13.5px;
    color: var(--ink-muted);
    word-break: break-word;
  }

  .row__note {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-body);
    margin: 6px 0 0;
    padding-left: 12px;
    border-left: 2px solid var(--line-strong);
  }

  .link {
    font: inherit;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    padding: 0 0 2px;
    cursor: pointer;
    transition: color 0.18s ease;
  }

  .link:hover {
    color: var(--accent);
  }

  .link--quiet {
    color: var(--ink-muted);
    font-weight: 500;
  }

  .form,
  .blockForm {
    display: grid;
    gap: 16px;
    margin-top: 22px;
  }

  .blockForm {
    grid-template-columns: 1fr 1fr;
    align-items: end;
  }

  .field {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .field--wide {
    grid-column: 1 / -1;
  }

  .field__label {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .field__input {
    font: inherit;
    font-size: 15.5px;
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    padding: 11px 13px;
    width: 100%;
  }

  .field__input:focus-visible {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .blockForm .btn {
    grid-column: 1 / -1;
    justify-self: start;
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .blockForm {
      grid-template-columns: 1fr;
    }
  }
</style>
