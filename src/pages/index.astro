---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ExperienceBar from '../components/ExperienceBar.astro';
import Services from '../components/Services.astro';
import AnalyzerStrip from '../components/AnalyzerStrip.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Products from '../components/Products.astro';
import PilotProgram from '../components/PilotProgram.astro';
import Pricing from '../components/Pricing.astro';
import BlogPreview from '../components/BlogPreview.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SITE } from '../data/site.mjs';
import { TERMS } from '../data/content.ts';

/** Set to `false` to hide the pricing section site-wide (the design's `showPricing` prop). */
const SHOW_PRICING = true;

/**
 * Един @graph с няколко възела вместо самотен ProfessionalService:
 * Organization и WebSite са „AI-friendly" типове (по-добра GEO оценка), а
 * FAQPage изкарва секцията с условията като двойки въпрос/отговор, които
 * отговарящите машини цитират директно. Въпросите идват от `TERMS`, за да
 * не се разминават с акордеона на страницата.
 */
const studioId = `${SITE.url}/#studio`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': studioId,
      name: SITE.name,
      description: SITE.description,
      url: SITE.url,
      email: SITE.email,
      foundingDate: String(SITE.founded),
      areaServed: 'BG',
      address: { '@type': 'PostalAddress', addressLocality: 'София', addressCountry: 'BG' },
      founder: {
        '@type': 'Person',
        name: SITE.owner.name,
        jobTitle: 'Senior AI Data Engineer',
        email: SITE.owner.email,
        sameAs: [SITE.owner.linkedin],
      },
      knowsLanguage: ['bg', 'en'],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      inLanguage: 'bg',
      publisher: { '@id': studioId },
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}/#faq`,
      mainEntity: TERMS.map((term) => ({
        '@type': 'Question',
        name: term.title,
        acceptedAnswer: { '@type': 'Answer', text: term.body },
      })),
    },
  ],
};
---

<BaseLayout canonical="/">
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  {/* Редът следва финалното копие: hero → услуги (+ лентата на анализатора
      до „Бизнес сайтове“) → процес → за мен → продукти → пилот → цени. */}
  <Hero />
  <ExperienceBar />
  <Services />
  <AnalyzerStrip />
  <Process />
  <About />
  <Products />
  <PilotProgram />
  {SHOW_PRICING && <Pricing />}
  <BlogPreview limit={4} />
  <CtaBanner />
</BaseLayout>
