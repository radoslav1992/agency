---
/**
 * Началната страница — разказ в шест движения, не каталог от единайсет секции.
 *
 * Беше: hero → агенти → услуги → анализатор → процес → за мен → продукти →
 * пилот → цени → блог → CTA. Единайсет равностойни блока, през които
 * читателят сам трябваше да си сглоби историята.
 *
 * Сега: закачка → напрежение → метод → каталог → безплатно доказателство →
 * построено доказателство → кой съм → CTA. Услугите, процесът, цените,
 * пилотът и условията се преместиха на `/services/`, където им е мястото:
 * това е справочник, а не разказ, и вече има собствен адрес.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ScrollStatement from '../components/ScrollStatement.astro';
import Journey from '../components/Journey.astro';
import AgentIndex from '../components/AgentIndex.astro';
import AnalyzerStrip from '../components/AnalyzerStrip.astro';
import Proof from '../components/Proof.astro';
import About from '../components/About.astro';
import BlogPreview from '../components/BlogPreview.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SITE } from '../data/site.mjs';

/**
 * Един @graph с няколко възела вместо самотен ProfessionalService:
 * Organization и WebSite са „AI-friendly" типове (по-добра GEO оценка).
 *
 * FAQPage вече НЕ е тук. Условията се преместиха на `/services/` заедно с
 * акордеона си, а схема, която описва съдържание извън страницата, е
 * грешка, която Search Console отчита.
 */
const studioId = `${SITE.url}/#studio`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': studioId,
      name: SITE.name,
      description: SITE.description,
      url: SITE.url,
      email: SITE.email,
      // E.164, не изписаният вид: `02 492 0201` не значи нищо извън България,
      // а Google чете точно това поле, за да покаже бутон „обади се“.
      telephone: SITE.phone.e164,
      foundingDate: String(SITE.founded),
      areaServed: 'BG',
      address: { '@type': 'PostalAddress', addressLocality: 'София', addressCountry: 'BG' },
      founder: {
        '@type': 'Person',
        name: SITE.owner.name,
        jobTitle: 'Senior AI Data Engineer',
        email: SITE.owner.email,
        sameAs: [SITE.owner.linkedin],
      },
      knowsLanguage: ['bg', 'en'],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      inLanguage: 'bg',
      publisher: { '@id': studioId },
    },
  ],
};
---

<BaseLayout canonical="/">
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <Hero />
  <ScrollStatement />
  <Journey />
  <AgentIndex />
  <AnalyzerStrip />
  <Proof />
  <About />
  <BlogPreview limit={3} />
  <CtaBanner />
</BaseLayout>
