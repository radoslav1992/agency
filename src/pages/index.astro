---
import TemplateHome from "../components/TemplateHome.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../data/site.mjs";

/**
 * Един @graph с няколко възела вместо самотен ProfessionalService:
 * Organization и WebSite са „AI-friendly" типове (по-добра GEO оценка).
 *
 * FAQPage вече НЕ е тук. Условията се преместиха на `/services/` заедно с
 * акордеона си, а схема, която описва съдържание извън страницата, е
 * грешка, която Search Console отчита.
 */
const studioId = `${SITE.url}/#studio`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": studioId,
      name: SITE.name,
      description: SITE.description,
      url: SITE.url,
      email: SITE.email,
      // E.164, не изписаният вид: `02 492 0201` не значи нищо извън България,
      // а Google чете точно това поле, за да покаже бутон „обади се“.
      telephone: SITE.phone.e164,
      foundingDate: String(SITE.founded),
      areaServed: "BG",
      address: {
        "@type": "PostalAddress",
        addressLocality: "София",
        addressCountry: "BG",
      },
      founder: {
        "@type": "Person",
        name: SITE.owner.name,
        jobTitle: "Senior AI Data Engineer",
        email: SITE.owner.email,
        sameAs: [SITE.owner.linkedin],
      },
      knowsLanguage: ["bg", "en"],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      inLanguage: "bg",
      publisher: { "@id": studioId },
    },
  ],
};
---

<BaseLayout canonical="/">
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <TemplateHome />
</BaseLayout>
