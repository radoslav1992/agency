---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { AGENTS, AGENT_PROCESS } from '../data/agents.ts';
import { agentShot } from '../data/agentShots.ts';
import { SITE } from '../data/site.mjs';

/**
 * Един водещ агент, останалите свити.
 *
 * Каталог от осем равностойни оферти казва „правя осем неща“ — при нула
 * пуснати инсталации това е обещание за продуктова готовност, каквато още
 * няма. Първият в списъка води, защото при него сметката е най-проста:
 * пропуснато обаждане = незаписан час.
 *
 * Останалите седем НЕ губят съдържание — само се свиват в `<details>`.
 * Текстът остава в HTML-а, тоест търсачките и отговарящите машини го четат
 * както преди; свива се само вниманието на човека.
 */
const [lead, ...rest] = AGENTS;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AI агенти от Кова студио',
  itemListElement: AGENTS.map((agent, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: agent.name,
      description: agent.short,
      areaServed: 'BG',
      provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    },
  })),
};
---

<BaseLayout
  title="AI агенти"
  description="Готови AI агенти за малки и средни компании: рецепционист по телефона, чат на сайта, агент върху фирмените документи, обработка на фактури, оферти и отчети. С ясен обхват и пилот преди голяма инвестиция."
  canonical="/agents/"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <div class="container wrap">
    <p class="eyebrow">AI агенти</p>
    <h1 class="title">Агенти, които поемат конкретна работа</h1>
    <p class="lead">
      Започвам с един — рецепциониста по телефона, защото при него сметката е най-проста.
      Отдолу са останалите седем: всеки с ясен обхват, ясно какво е нужно от теб и ясно къде не
      става. Работим по един канал наведнъж, с пилот върху твои данни.
    </p>

    {/* ---------- Водещата оферта ---------- */}
    <article class="agent agent--lead" id={lead.id}>
      <div class="agent__top">
        {agentShot(lead.id) && (
          <Image
            class="agent__shot"
            src={agentShot(lead.id)!}
            alt={lead.alt}
            widths={[420, 630, 840]}
            sizes="(max-width: 780px) 92vw, 420px"
            loading="eager"
          />
        )}
        <div class="agent__intro">
          <header class="agent__head">
            <span class="agent__channel">{lead.channel}</span>
            <h2 class="agent__name">{lead.name}</h2>
            {lead.demo && <span class="agent__demo">Мога да го покажа на живо</span>}
          </header>
          <p class="agent__problem">{lead.problem}</p>
        </div>
      </div>

      {/* Сметката е с ЧУЖДИ числа нарочно: сайтът обещава, че не твърди
          неизмерени резултати, а тук читателят смята своя случай сам. */}
      <div class="sum">
        <h3 class="sum__title">Сметката е твоя, не моя</h3>
        <p class="sum__body">
          Едно пропуснато обаждане е един незаписан час. Колко са на седмица при теб? Умножи ги по
          това, което един час ти носи. Три обаждания седмично по 80 лв. правят
          <strong> около 960 лв. на месец</strong>, които не влизат.
        </p>
        <p class="sum__note">
          Числата са твои. Ако при теб са две обаждания по 60 лв., сметката е друга и може изобщо
          да не си струва — ще го проверим в разговора, преди да платиш каквото и да е.
        </p>
      </div>

      <div class="agent__cols">
        <div>
          <h3 class="agent__label">Какво прави</h3>
          <ul class="agent__list">{lead.does.map((d) => <li>{d}</li>)}</ul>
        </div>
        <div>
          <h3 class="agent__label">Какво е нужно от теб</h3>
          <ul class="agent__list agent__list--plain">{lead.needs.map((n) => <li>{n}</li>)}</ul>
          <h3 class="agent__label agent__label--spaced">Подходящ за</h3>
          <p class="agent__best">{lead.bestFor}</p>
        </div>
      </div>

      <p class="agent__limits">
        <strong>Къде не става:</strong> {lead.limits}
      </p>

      <a class="btn btn--primary agent__cta" href="/contact/">Запази разговор за рецепциониста →</a>
    </article>

    {/* ---------- Останалите, свити ---------- */}
    <h2 class="rest__title">И още седем, по същия начин</h2>
    <p class="rest__note">
      Всеки от тях решава друг повтарящ се канал. Отвори онзи, който ти звучи познато — вътре е
      същото: какво прави, какво иска от теб и къде не става.
    </p>

    <nav class="jump" aria-label="Списък с агентите">
      {rest.map((agent) => <a href={`#${agent.id}`}>{agent.name}</a>)}
    </nav>

    <div class="agents">
      {
        rest.map((agent) => (
          <details class="agent agent--folded" id={agent.id}>
            <summary class="agent__summary">
              <span class="agent__channel">{agent.channel}</span>
              <span class="agent__name agent__name--small">{agent.name}</span>
              <span class="agent__short">{agent.short}</span>
            </summary>
            {/* Рисунката е същата, която стои и във въртележката — така
                човек, дошъл от началната страница, разпознава агента. */}
            <div class="agent__top">
              {agentShot(agent.id) && (
                <Image
                  class="agent__shot"
                  src={agentShot(agent.id)!}
                  alt={agent.alt}
                  widths={[340, 510, 680]}
                  sizes="(max-width: 780px) 92vw, 340px"
                  loading="lazy"
                />
              )}
              <div class="agent__intro">
                {agent.demo && <span class="agent__demo">Мога да го покажа на живо</span>}
                <p class="agent__problem">{agent.problem}</p>
              </div>
            </div>

            <div class="agent__cols">
              <div>
                <h3 class="agent__label">Какво прави</h3>
                <ul class="agent__list">
                  {agent.does.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="agent__label">Какво е нужно от теб</h3>
                <ul class="agent__list agent__list--plain">
                  {agent.needs.map((n) => (
                    <li>{n}</li>
                  ))}
                </ul>
                <h3 class="agent__label agent__label--spaced">Подходящ за</h3>
                <p class="agent__best">{agent.bestFor}</p>
              </div>
            </div>

            <p class="agent__limits">
              <strong>Къде не става:</strong> {agent.limits}
            </p>
          </details>
        ))
      }
    </div>

    <section class="process" aria-labelledby="process-title">
      <h2 class="process__title" id="process-title">Как започва един агент</h2>
      <ol class="process__steps">
        {
          AGENT_PROCESS.map((step, i) => (
            <li>
              <span class="process__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="process__name">{step.title}</span>
              <span class="process__body">{step.body}</span>
            </li>
          ))
        }
      </ol>
      <p class="process__note">
        Пилотът тръгва от 1 500 €. Към него вървят месечни разходи за телефония и модели, които
        зависят от обема — казвам ти ги в офертата, преди да започнем.
      </p>
    </section>

    <section class="honest" aria-labelledby="honest-title">
      <h2 class="honest__title" id="honest-title">Какво няма да чуеш от мен</h2>
      <ul class="honest__list">
        <li>Че агентът не греши. Греши — затова пилотът измерва колко и къде.</li>
        <li>Че заменя човек. Поема повторяемото; преценката остава при теб.</li>
        <li>
          Че данните са „в облака и няма проблем“. При чувствителни данни моделът работи в
          твоята инфраструктура, а при разговори се иска съгласие за запис.
        </li>
      </ul>
    </section>
  </div>

  <CtaBanner />
</BaseLayout>

<script>
  /*
   * Връзка към свит агент трябва да го отвори. Браузърите го правят сами
   * само в най-новите версии, а котвите идват и от въртележката на
   * началната страница — тоест мълчаливото несработване би било често.
   */
  function openTarget() {
    const id = location.hash.slice(1);
    if (!id) return;
    const target = document.getElementById(id);
    const fold = target?.closest('details');
    if (!fold) return;
    fold.open = true;
    fold.scrollIntoView({ block: 'start', behavior: 'auto' });
  }

  openTarget();
  window.addEventListener('hashchange', openTarget);
</script>

<style>
  .wrap {
    padding-block: 76px 88px;
  }

  .title {
    font-size: clamp(32px, 6vw, 48px);
    letter-spacing: -0.035em;
    margin: 12px 0;
  }

  .lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 640px;
    margin: 0 0 28px;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 48px;
  }

  .jump a {
    font-size: 13.5px;
    background: var(--chip);
    border-radius: 999px;
    padding: 7px 14px;
    color: var(--ink-body);
  }

  .jump a:hover {
    background: var(--accent);
    color: #fff;
  }

  .agents {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .agent {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 30px;
    scroll-margin-top: calc(var(--header-h) + 20px);
  }

  /* Рисунката отляво, заглавието и проблемът отдясно. */
  .agent__top {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 26px;
    align-items: start;
    margin-bottom: 22px;
  }

  .agent__shot {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-blush);
  }

  .agent__intro {
    min-width: 0;
  }

  /* ---------- Водещата оферта ---------- */
  .agent--lead {
    border-color: var(--accent);
    padding: 34px;
  }

  .agent--lead .agent__top {
    grid-template-columns: 420px 1fr;
  }

  .agent--lead .agent__name {
    font-size: clamp(24px, 3.4vw, 31px);
  }

  .agent__cta {
    margin-top: 24px;
  }

  /* Сметката — числата са на читателя, не мои. */
  .sum {
    background: var(--bg-blush);
    border-radius: 16px;
    padding: 20px 22px;
    margin-bottom: 22px;
  }

  .sum__title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    margin: 0;
  }

  .sum__body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-body);
    margin: 8px 0 0;
  }

  .sum__note {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-subtle);
    margin: 10px 0 0;
  }

  /* ---------- Останалите седем, свити ---------- */
  .rest__title {
    font-size: clamp(21px, 3vw, 26px);
    letter-spacing: -0.025em;
    margin: 64px 0 8px;
  }

  .rest__note {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 620px;
    margin: 0 0 24px;
  }

  .agent--folded {
    padding: 0;
  }

  .agent__summary {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
  }

  .agent__summary::-webkit-details-marker {
    display: none;
  }

  .agent__summary::after {
    content: '+';
    margin-left: auto;
    font-size: 20px;
    line-height: 1;
    color: var(--ink-subtle);
  }

  .agent--folded[open] .agent__summary::after {
    content: '−';
  }

  .agent--folded[open] .agent__summary {
    border-bottom: 1px solid var(--line);
  }

  .agent__name--small {
    font-size: 17.5px;
  }

  .agent__short {
    flex-basis: 100%;
    font-size: 14.5px;
    color: var(--ink-muted);
  }

  .agent--folded > *:not(.agent__summary) {
    padding-inline: 24px;
  }

  .agent--folded > .agent__top {
    padding-top: 22px;
  }

  .agent--folded > .agent__limits {
    margin-bottom: 22px;
  }

  .agent__head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .agent__channel {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
    padding: 4px 11px;
  }

  .agent__name {
    font-size: clamp(20px, 3vw, 25px);
    letter-spacing: -0.025em;
    margin: 0;
  }

  .agent__demo {
    font-size: 12px;
    background: var(--chip);
    color: var(--ink-muted);
    border-radius: 999px;
    padding: 4px 10px;
  }

  .agent__problem {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--ink-body);
    /* Долният отстъп идва от `.agent__top`, за да не се удвои. */
    margin: 16px 0 0;
    max-width: 680px;
  }

  .agent__cols {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 28px;
  }

  .agent__label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin: 0 0 10px;
  }

  .agent__label--spaced {
    margin-top: 20px;
  }

  .agent__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-body);
  }

  .agent__list li::before {
    content: '✓ ';
    color: var(--success, #34a853);
  }

  .agent__list--plain li::before {
    content: '· ';
    color: var(--ink-faint);
  }

  .agent__best {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-muted);
    margin: 0;
  }

  .agent__limits {
    margin: 22px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .agent__limits strong {
    color: var(--ink);
  }

  .process,
  .honest {
    margin-top: 56px;
  }

  .process__title,
  .honest__title {
    font-size: clamp(22px, 3.5vw, 28px);
    letter-spacing: -0.025em;
    margin: 0 0 22px;
  }

  .process__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process__steps li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--bg-sand);
    border-radius: 18px;
    padding: 22px;
  }

  .process__num {
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--ink-faint);
  }

  .process__name {
    font-weight: 600;
    font-size: 16px;
  }

  .process__body {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .process__note {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 20px 0 0;
    max-width: 680px;
  }

  .honest__list {
    margin: 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-body);
    max-width: 700px;
  }

  @media (max-width: 900px) {
    .agent__cols {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .process__steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 780px) {
    /* Под тази ширина рисунката отнема твърде много от текста — сяда отгоре. */
    .agent__top,
    .agent--lead .agent__top {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }

  @media (max-width: 680px) {
    .wrap {
      padding-block: 48px 56px;
    }

    .agent {
      padding: 24px 20px;
    }

    .process__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
