---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../data/site.mjs';
---

<BaseLayout
  title="Контакти"
  description="Пиши на Кова студио — AI асистент, автоматизация, вътрешна система, бизнес сайт или обучение. Преглеждам всяко запитване лично и отговарям до един работен ден."
  canonical="/contact/"
>
  <div class="container wrap">
    <div class="lead-col">
      <p class="eyebrow">Контакти</p>
      <h1 class="title">Нека видим дали мога да помогна.</h1>
      <p class="lead">
        Разкажи ми накратко как работи процесът в момента и какво искаш да подобриш. Ще прегледам
        запитването лично и ще ти отговоря до един работен ден.
      </p>
      <ContactForm />
    </div>

    <aside class="side">
      <div class="panel">
        <p class="panel__title panel__title--ink">Какво се случва след това?</p>
        <p class="panel__text">
          Преглеждам запитването лично и ти отговарям до един работен ден. Ако проектът е
          подходящ, уговаряме безплатен 30-минутен разговор. След него получаваш кратка оферта с
          конкретен обхват, срок и цена.
        </p>
        <p class="panel__text">
          Ако преценя, че друг подход или специалист е по-подходящ, ще ти го кажа директно.
        </p>
      </div>

      <div class="panel panel--dark">
        <p class="panel__title">Предпочиташ да пишеш по имейл?</p>
        <p class="panel__label">Общи запитвания</p>
        <a class="panel__link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <p class="panel__label">Директно до Радослав</p>
        <a class="panel__link" href={`mailto:${SITE.owner.email}`}>{SITE.owner.email}</a>
        <a class="panel__link panel__link--secondary" href={SITE.owner.linkedin} target="_blank" rel="noopener">
          {SITE.owner.linkedinLabel}
        </a>
      </div>

      <div class="panel">
        <p class="panel__title panel__title--ink">Безплатен 30-минутен разговор</p>
        <p class="panel__text">
          Разговорът е безплатен и не те ангажира с поръчка. Можем да се чуем онлайн или да се
          срещнем в София.
        </p>
        <a
          class="panel__cta"
          href={SITE.bookingUrl ?? `mailto:${SITE.owner.email}?subject=${encodeURIComponent('Разговор 30 мин.')}`}
          {...SITE.bookingUrl ? { target: '_blank', rel: 'noopener' } : {}}
        >
          {SITE.bookingUrl ? 'Избери час в календара' : 'Предложи час за разговор'}
        </a>
      </div>

      <div class="panel">
        <p class="panel__address">
          {SITE.name} е базирано в София.<br />Работя дистанционно с клиенти от цялата страна.
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .wrap {
    padding-block: 76px 96px;
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 56px;
    align-items: start;
  }

  .title {
    font-size: clamp(32px, 5.5vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 12px 0 14px;
  }

  .lead {
    font-size: 18px;
    color: var(--ink-muted);
    margin: 0 0 34px;
    max-width: 520px;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 24px;
  }

  .panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 28px;
  }

  .panel--dark {
    background: var(--dark);
    border-color: var(--dark);
    color: #fff;
  }

  .panel__title {
    font-family: var(--font-display);
    font-size: 18px;
    margin: 0 0 16px;
  }

  .panel__title--ink {
    margin-bottom: 10px;
  }

  .panel__link {
    display: block;
    font-size: 16px;
    color: #fff;
    word-break: break-word;
  }

  .panel__link:hover {
    color: var(--accent-soft);
    text-decoration: underline;
  }

  .panel__label {
    font-size: 12.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.6);
    margin: 14px 0 4px;
  }

  .panel__label:first-of-type {
    margin-top: 0;
  }

  .panel__link--secondary {
    margin-top: 14px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
  }

  .panel__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0 0 16px;
  }

  .panel__cta {
    display: inline-block;
    border: 1px solid var(--ink);
    padding: 12px 20px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
    transition:
      background-color 0.18s ease,
      color 0.18s ease;
  }

  .panel__cta:hover {
    background: var(--ink);
    color: #fff;
  }

  .panel__address {
    font-size: 14px;
    color: var(--ink-muted);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 940px) {
    .wrap {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 48px 64px;
    }

    .side {
      padding-top: 0;
    }
  }
</style>
