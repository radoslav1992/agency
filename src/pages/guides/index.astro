---
/**
 * Рафтът — всички наръчници на едно място.
 *
 * Списък от РЕДОВЕ, а не решетка от карти, и това е нарочно: при един
 * наръчник решетката оставя дупки и рафтът изглежда празен, а редът си стои
 * цял. При десет реда се превърта като каталог. Едно оформление за двата
 * случая, без „ако са повече от N“.
 *
 * Всеки ред е цялата корица плюс четирите части — човек трябва да може да
 * реши оттук дали да влезе, а не да отваря страници една по една.
 *
 * Само на български. Наръчниците са „Българско издание“; страница на
 * английски за книги, които не съществуват на английски, е обещание, което
 * не се спазва.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDES, isSellable, priceLabel } from '../../data/guides.ts';
import { coverOf } from '../../lib/guide-cover.ts';
import { SITE } from '../../data/site.mjs';

const shelf = GUIDES.map((guide) => ({
  guide,
  cover: coverOf(guide.cover),
  sellable: isSellable(guide),
  price: priceLabel(guide),
}));

/* „1 наръчник“, „2 наръчника“, „5 наръчника“ — българското броене след
   числително е „наръчника“ при всяко число освен едно. */
const count = GUIDES.length;
const countLabel = count === 1 ? 'Един наръчник' : `${count} наръчника`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Наръчници на Кова студио',
  itemListElement: GUIDES.map((guide, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Book',
      name: guide.title,
      description: guide.short,
      inLanguage: 'bg',
      bookEdition: guide.edition,
      author: { '@type': 'Person', name: SITE.owner.name },
      url: new URL(`/guides/${guide.slug}/`, SITE.url).href,
    },
  })),
};
---

<BaseLayout
  title="Наръчници"
  description="Практически наръчници за AI на български: как се създават, поддържат и продават AI рецепционисти, гласови асистенти и автоматизации. Цялата процедура, не теория."
  canonical="/guides/"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </Fragment>

  {/* ---------- заглавие ---------- */}
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">Наръчници</p>
      <h1 class="hero__title">Същото, което правя за клиенти — описано, за да го направиш сам</h1>
      <p class="hero__lead">
        Всеки наръчник е една процедура от край до край: кога си струва, как се изгражда, къде
        се чупи и как се остойностява. Включително частите, които обикновено липсват, защото са
        скучни — и заради които проектите спират на две трети.
      </p>
      <p class="hero__count">{countLabel} · поредицата расте</p>
    </div>
  </section>

  {/* ---------- рафтът ---------- */}
  <section class="shelf" id="shelf">
    <div class="container">
      <ul class="shelf__list">
        {
          shelf.map(({ guide, cover, sellable, price }, i) => (
            <li class="row" style={`--i: ${i}`}>
              <a class="row__link" href={`/guides/${guide.slug}/`}>
                <div class="row__art">
                  {cover ? (
                    <Image
                      class="row__cover"
                      src={cover}
                      alt={`Корица на „${guide.title}“`}
                      widths={[240, 360, 480]}
                      sizes="(max-width: 720px) 45vw, 240px"
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                  ) : (
                    <div class="row__cover row__cover--empty" aria-hidden="true">
                      <span>{guide.title}</span>
                    </div>
                  )}
                </div>

                <div class="row__body">
                  <div class="row__meta">
                    {sellable ? (
                      <span class="tag tag--price">{price}</span>
                    ) : (
                      <span class="tag tag--soon">Скоро</span>
                    )}
                    <span class="row__edition">{guide.edition}</span>
                  </div>

                  <h2 class="row__title">{guide.title}</h2>
                  <p class="row__sub">{guide.subtitle}</p>
                  <p class="row__short">{guide.short}</p>

                  <ul class="row__parts">
                    {guide.pillars.map((pillar) => (
                      <li>{pillar.title}</li>
                    ))}
                  </ul>

                  <span class="row__cta">
                    {sellable ? `Виж какво има вътре — ${price}` : 'Виж какво има вътре'} →
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---------- защо изобщо ги има ---------- */}
  <section class="why">
    <div class="container why__inner">
      <div class="why__col">
        <h2 class="why__title">Блогът е безплатен</h2>
        <p class="why__body">
          И си остава. Там пиша по теми — какво излиза, какво работи, какво не. Полезно за
          решение, но недостатъчно за пускане в работа.
        </p>
        <a class="why__link" href="/blog/">Към блога →</a>
      </div>
      <div class="why__col why__col--mid">
        <h2 class="why__title">Наръчникът е процедурата</h2>
        <p class="why__body">
          От „струва ли си“ до „кой плаща минутите“ и „каква цена да сложа“. С числата, с
          местата, където се чупи, и с това, което казвам на клиента, преди да е попитал.
        </p>
        <a class="why__link" href="#shelf">Виж наръчниците ↑</a>
      </div>
      <div class="why__col">
        <h2 class="why__title">Или го правя аз</h2>
        <p class="why__body">
          Ако прочетеш съдържанието и решиш, че времето ти струва повече от разликата в цената
          — това е напълно разумно и е другата ми работа.
        </p>
        <a class="why__link" href="/services/">Услуги и цени →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- заглавие ---------- */

  .hero {
    padding-block: clamp(48px, 7vw, 92px) clamp(32px, 5vw, 56px);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(52% 60% at 82% 30%, rgba(46, 92, 173, 0.12), transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5.4vw, 62px);
    line-height: 1;
    letter-spacing: -0.045em;
    margin: 14px 0 0;
    max-width: 17ch;
  }

  .hero__lead {
    font-size: clamp(16.5px, 1.8vw, 19px);
    line-height: 1.6;
    color: var(--ink-body);
    margin: 22px 0 0;
    max-width: 58ch;
  }

  .hero__count {
    font-size: 13.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-subtle);
    margin: 26px 0 0;
  }

  /* ---------- рафтът ---------- */

  .shelf {
    padding-block: clamp(24px, 4vw, 48px) clamp(64px, 9vw, 112px);
  }

  .shelf__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(20px, 3vw, 32px);
  }

  .row__link {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    color: inherit;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 26px;
    padding: clamp(24px, 3.4vw, 44px);
    box-shadow: var(--shadow-card);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .row__link:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .row__art {
    /* Сиянието стои под корицата и тук — тъмносиньото върху кремаво иска
       собствена среда, иначе изглежда като изрязано. */
    position: relative;
    display: grid;
    place-items: center;
    padding: 8px;
  }

  .row__art::before {
    content: '';
    position: absolute;
    inset: -14%;
    background: radial-gradient(closest-side, rgba(46, 92, 173, 0.22), transparent 78%);
    pointer-events: none;
  }

  .row__cover {
    position: relative;
    width: clamp(120px, 20vw, 200px);
    height: auto;
    display: block;
    border-radius: 8px;
    transform: rotate(-2deg);
    filter: drop-shadow(0 16px 28px rgba(12, 24, 48, 0.28));
  }

  .row__cover--empty {
    display: grid;
    place-items: center;
    aspect-ratio: 2 / 3;
    padding: 16px;
    text-align: center;
    background: #0b1830;
    color: #cfe0ff;
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: -0.02em;
  }

  .row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .tag--soon,
  .tag--price {
    display: inline-flex;
    align-items: center;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
    padding: 5px 12px;
  }

  .tag--price {
    letter-spacing: 0.02em;
    font-size: 13px;
  }

  .row__edition {
    font-size: 13px;
    color: var(--ink-subtle);
  }

  .row__title {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.4vw, 40px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    margin: 14px 0 0;
  }

  .row__sub {
    font-size: clamp(15.5px, 1.7vw, 18px);
    line-height: 1.45;
    font-weight: 500;
    color: var(--ink);
    margin: 12px 0 0;
    max-width: 40ch;
  }

  .row__short {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-body);
    margin: 12px 0 0;
    max-width: 52ch;
  }

  .row__parts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0;
  }

  .row__parts li {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: var(--chip);
    border-radius: 999px;
    padding: 6px 12px;
  }

  .row__cta {
    display: inline-block;
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
    margin-top: 22px;
  }

  /* ---------- защо ---------- */

  .why {
    background: var(--bg-sand);
    border-top: 1px solid var(--line);
    padding-block: clamp(56px, 8vw, 104px);
  }

  .why__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 56px);
  }

  .why__col--mid {
    padding-inline: clamp(24px, 4vw, 56px);
    border-inline: 1px solid var(--line);
  }

  .why__title {
    font-family: var(--font-display);
    font-size: clamp(19px, 2.2vw, 24px);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .why__body {
    font-size: 15.5px;
    line-height: 1.62;
    color: var(--ink-body);
    margin: 14px 0 0;
  }

  .why__link {
    display: inline-block;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--accent);
    margin-top: 16px;
  }

  /* ---------- движението ----------
   *
   * Основното състояние горе е КРАЙНОТО: без поддръжка и при изключено
   * движение рафтът е просто статичен и цял.
   */

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .row {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 4% cover 22%;
      }

      .row__cover {
        animation: cover-tilt linear both;
        animation-timeline: view();
        animation-range: entry 8% cover 34%;
      }
    }
  }

  @keyframes cover-tilt {
    from {
      transform: rotate(-7deg) scale(0.93);
    }
    to {
      transform: rotate(-2deg) scale(1);
    }
  }

  @media (max-width: 720px) {
    .row__link {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 24px;
    }

    /* На тесен екран корицата е единственото над сгъвката — 20vw я свиваше
       до пощенска марка точно там, където е най-силният аргумент. */
    .row__cover {
      width: min(210px, 48vw);
    }

    .why__inner {
      grid-template-columns: 1fr;
    }

    .why__col--mid {
      padding-inline: 0;
      padding-block: clamp(24px, 6vw, 40px);
      border-inline: 0;
      border-block: 1px solid var(--line);
    }
  }
</style>
