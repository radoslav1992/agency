---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { PROJECTS } from '../data/projects.ts';

/** Примери за процеси, подходящи за пилотната програма. */
const PILOT_EXAMPLES = [
  'обработка на документи и входящи заявки',
  'търсене във фирмени договори, процедури и инструкции',
  'автоматично подготвяне на справки и отчети',
  'прехвърляне на информация между различни системи',
  'вътрешен портал вместо работа с таблици и имейли',
];
---

<BaseLayout
  title="Проекти"
  description="Продукти, разработени от Кова студио — от първоначалната идея до пускането и поддръжката. Всеки от тях работи в момента и може да бъде изпробван."
  canonical="/projects/"
>
  <div class="container wrap">
    <p class="eyebrow">Проекти</p>
    <h1 class="title">Продукти, които можеш да изпробваш</h1>
    <p class="lead">
      Тук показвам продукти, които съм разработил от първоначалната идея до пускането и
      поддръжката. Всеки от тях работи в момента и може да бъде отворен и изпробван.
    </p>

    <section class="pilot" id="pilot" aria-labelledby="pilot-title">
      <h2 class="pilot__title" id="pilot-title">Пилотна програма за компании</h2>
      <p class="pilot__body">
        В момента отварям три места за компании, които искат да проверят дали конкретен
        повтарящ се процес може да бъде автоматизиран.
      </p>
      <p class="pilot__body">Подходящи примери са:</p>
      <ul class="pilot__list">
        {PILOT_EXAMPLES.map((example) => <li>{example}</li>)}
      </ul>
      <p class="pilot__body">
        Пилотът е платен, с ограничен обхват и предварително определена цел. В рамките на
        програмата предлагам 20% по-ниска цена. След приключването можем да публикуваме
        резултатите като клиентски казус, но само след твоето изрично одобрение.
      </p>
      <a class="btn btn--primary" href="/contact/">Заяви място в пилотната програма →</a>
    </section>

    <section class="block" aria-labelledby="own-products">
      <h2 class="block__title" id="own-products">Проекти</h2>
      <p class="block__note">
        Повечето от тях са поръчани от клиенти; двата с етикет „Собствен продукт“ са мои. И в
        двата случая проектът минава през мен от архитектурата и интерфейса до пускането и
        ежедневната работа на системата.
      </p>
      <div class="grid">
        {PROJECTS.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </div>

  <CtaBanner />
</BaseLayout>

<style>
  .wrap {
    padding-block: 76px 88px;
  }

  .title {
    font-size: clamp(32px, 6vw, 48px);
    letter-spacing: -0.035em;
    margin: 12px 0;
  }

  .lead {
    font-size: 18px;
    color: var(--ink-muted);
    max-width: 620px;
    margin: 0 0 48px;
  }

  .pilot {
    background: var(--bg-sand);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 32px;
    max-width: 760px;
    margin-bottom: 56px;
  }

  .pilot__title {
    font-size: clamp(20px, 3vw, 24px);
    letter-spacing: -0.025em;
    margin: 0 0 14px;
  }

  .pilot__body {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-body);
    margin: 0 0 12px;
  }

  .pilot__list {
    margin: 0 0 14px;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-body);
  }

  .pilot .btn {
    margin-top: 8px;
  }

  .block__title {
    font-size: clamp(22px, 3.5vw, 28px);
    letter-spacing: -0.025em;
    margin: 0 0 16px;
  }

  .block__note {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 680px;
    margin: 0 0 28px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .wrap {
      padding-block: 48px 56px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .pilot {
      padding: 24px 20px;
    }
  }
</style>
