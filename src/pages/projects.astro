---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { PROJECTS } from '../data/projects.ts';
---

<BaseLayout
  title="Казуси и продукти"
  description="Клиентски казуси и собствени продукти на Кова студио (Kova Labs). Всичко работи в момента — отвори което и да е и виж сам."
  canonical="/projects/"
>
  <div class="container wrap">
    <p class="eyebrow">Казуси</p>
    <h1 class="title">Казуси и продукти</h1>
    <p class="lead">
      Разделени честно на две: работа за външни клиенти и собствени продукти на студиото. Всичко
      тук работи в момента — отвори което и да е и виж сам.
    </p>

    <section class="block" aria-labelledby="client-cases">
      <h2 class="block__title" id="client-cases">Клиентски казуси</h2>
      <div class="pilot">
        <p class="pilot__lead">
          Тук ще стоят подробни казуси от външни проекти — с проблем, решение, срок, архитектура и
          измерим резултат.
        </p>
        <p class="pilot__body">
          В момента набирам <strong>три пилотни проекта</strong> за компании, които искат да
          автоматизират конкретен процес — с 20% отстъпка срещу правото да публикувам казуса с
          измерими резултати. Платен пилот, реален ангажимент и от двете страни.
        </p>
        <a class="btn btn--primary" href="/contact/">Кандидатствай за пилотен проект</a>
      </div>
    </section>

    <section class="block" aria-labelledby="kova-labs">
      <h2 class="block__title" id="kova-labs">Kova Labs — собствени продукти</h2>
      <p class="block__note">
        Не само разработвам за клиенти — създавам, пускам и поддържам собствени продукти. Те
        доказват, че мога да изградя и пусна работещ продукт от нулата: продуктова архитектура,
        AI обработка, интерфейс и поддръжка.
      </p>
      <div class="grid">
        {PROJECTS.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </div>

  <CtaBanner />
</BaseLayout>

<style>
  .wrap {
    padding-block: 76px 88px;
  }

  .title {
    font-size: clamp(32px, 6vw, 48px);
    letter-spacing: -0.035em;
    margin: 12px 0;
  }

  .lead {
    font-size: 18px;
    color: var(--ink-muted);
    max-width: 620px;
    margin: 0 0 48px;
  }

  .block + .block {
    margin-top: 56px;
  }

  .block__title {
    font-size: clamp(22px, 3.5vw, 28px);
    letter-spacing: -0.025em;
    margin: 0 0 16px;
  }

  .block__note {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 680px;
    margin: 0 0 28px;
  }

  .pilot {
    background: var(--bg-sand);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 32px;
    max-width: 760px;
  }

  .pilot__lead {
    font-size: 17px;
    font-weight: 600;
    margin: 0 0 12px;
  }

  .pilot__body {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-body);
    margin: 0 0 20px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .wrap {
      padding-block: 48px 56px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .pilot {
      padding: 24px 20px;
    }
  }
</style>
