---
/** Английското огледало на началната страница — същите шест движения. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ScrollStatement from '../../components/ScrollStatement.astro';
import Journey from '../../components/Journey.astro';
import AgentIndex from '../../components/AgentIndex.astro';
import Proof from '../../components/Proof.astro';
import About from '../../components/About.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { SITE } from '../../data/site.mjs';
import { localeOf } from '../../i18n/index.ts';
import { brand, location, meta, owner } from '../../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const m = meta(lang);
const studio = brand(lang);
const where = location(lang);
const who = owner(lang);

/**
 * Organization и WebSite са „AI-friendly" типове (по-добра GEO оценка).
 * FAQPage се премести на `/en/services/` заедно с акордеона на условията.
 */
const studioId = `${SITE.url}/#studio`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': studioId,
      name: studio.name,
      description: m.description,
      url: SITE.url,
      email: SITE.email,
      foundingDate: String(SITE.founded),
      areaServed: 'BG',
      address: { '@type': 'PostalAddress', addressLocality: where.city, addressCountry: 'BG' },
      founder: {
        '@type': 'Person',
        name: who.name,
        jobTitle: 'Senior AI Data Engineer',
        email: SITE.owner.email,
        sameAs: [SITE.owner.linkedin],
      },
      knowsLanguage: ['bg', 'en'],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/en/#website`,
      url: `${SITE.url}/en/`,
      name: studio.name,
      inLanguage: 'en',
      publisher: { '@id': studioId },
    },
  ],
};
---

<BaseLayout canonical="/en/">
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  {/* Същият ред като на български, без двете секции, които съществуват
      само на български — анализаторът и блогът. */}
  <Hero />
  <ScrollStatement />
  <Journey />
  <AgentIndex />
  <Proof />
  <About />
  <CtaBanner />
</BaseLayout>
