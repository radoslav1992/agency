---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { localeOf } from '../../i18n/index.ts';
import { projects as projectsFor } from '../../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const { PROJECTS } = projectsFor(lang);

/** Примери за процеси, подходящи за пилотната програма. */
const PILOT_EXAMPLES = [
  'processing documents and incoming orders',
  'searching company contracts, procedures and instructions',
  'preparing reports automatically',
  'moving information between separate systems',
  'an internal portal instead of spreadsheets and email threads',
];
---

<BaseLayout
  title="Projects"
  description="Products built by Kova Studio — from the first idea through launch and support. Every one of them is live and can be tried right now."
  canonical="/en/projects/"
>
  <div class="container wrap">
    <p class="eyebrow">Projects</p>
    <h1 class="title">Products you can try right now</h1>
    <p class="lead">
      These are products I built from the first idea through launch and support. Every one of
      them is live, and you can open it and try it.
    </p>

    <section class="pilot" id="pilot" aria-labelledby="pilot-title">
      <h2 class="pilot__title" id="pilot-title">A pilot programme for companies</h2>
      <p class="pilot__body">
        I keep three places open for companies that want to find out whether one specific
        repeating process can be automated.
      </p>
      <p class="pilot__body">Suitable examples:</p>
      <ul class="pilot__list">
        {PILOT_EXAMPLES.map((example) => <li>{example}</li>)}
      </ul>
      <p class="pilot__body">
        The pilot is paid, bounded in scope and set against an agreed goal. Inside the programme
        the price is 20% lower. Afterwards we can publish the results as a case study — but only
        with your explicit approval.
      </p>
      <a class="btn btn--primary" href="/en/contact/">Claim a pilot place →</a>
    </section>

    <section class="block" aria-labelledby="own-products">
      <h2 class="block__title" id="own-products">Projects</h2>
      <p class="block__note">
        Most were commissioned by clients; the two marked "Own product" are mine. In either case
        the project goes through me — from the architecture and the interface to launch and the
        day-to-day running of the system.
      </p>
      <div class="grid">
        {PROJECTS.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </div>

  <CtaBanner />
</BaseLayout>

<style>
  .wrap {
    padding-block: 76px 88px;
  }

  .title {
    font-size: clamp(32px, 6vw, 48px);
    letter-spacing: -0.035em;
    margin: 12px 0;
  }

  .lead {
    font-size: 18px;
    color: var(--ink-muted);
    max-width: 620px;
    margin: 0 0 48px;
  }

  .pilot {
    background: var(--bg-sand);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 32px;
    max-width: 760px;
    margin-bottom: 56px;
  }

  .pilot__title {
    font-size: clamp(20px, 3vw, 24px);
    letter-spacing: -0.025em;
    margin: 0 0 14px;
  }

  .pilot__body {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-body);
    margin: 0 0 12px;
  }

  .pilot__list {
    margin: 0 0 14px;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-body);
  }

  .pilot .btn {
    margin-top: 8px;
  }

  .block__title {
    font-size: clamp(22px, 3.5vw, 28px);
    letter-spacing: -0.025em;
    margin: 0 0 16px;
  }

  .block__note {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 680px;
    margin: 0 0 28px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .wrap {
      padding-block: 48px 56px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .pilot {
      padding: 24px 20px;
    }
  }
</style>
