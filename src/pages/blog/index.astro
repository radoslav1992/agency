---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate } from '../../lib/posts.ts';

const posts = await getPosts();
---

<BaseLayout
  title="Блог"
  description="Записки за AI, уеб и малкия бизнес — кратки, практични текстове без хайп."
  canonical="/blog/"
>
  <div class="container wrap">
    <p class="eyebrow">Блог</p>
    <h1 class="title">Записки за AI, уеб и малкия бизнес</h1>
    <p class="lead">Кратки, практични текстове. Без хайп, без „революция“ през ред.</p>

    {
      posts.length === 0 ? (
        <p class="empty">Първите публикации идват скоро.</p>
      ) : (
        <ul class="grid">
          {posts.map((post) => (
            <li>
              <a class="card post" href={`/blog/${post.id}/`}>
                <span class="post__meta">
                  <span class="post__tag">{post.data.tag}</span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span>{post.data.readMinutes} мин</span>
                  {post.data.draft && <span class="post__draft">чернова</span>}
                </span>
                <h2 class="post__title">{post.data.title}</h2>
                <p class="post__excerpt">{post.data.excerpt}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .wrap {
    padding-block: 76px 96px;
  }

  .title {
    font-size: clamp(32px, 6vw, 48px);
    letter-spacing: -0.035em;
    margin: 12px 0;
  }

  .lead {
    font-size: 18px;
    color: var(--ink-muted);
    max-width: 620px;
    margin: 0 0 48px;
  }

  .empty {
    color: var(--ink-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post {
    display: block;
    height: 100%;
    color: inherit;
    transition: border-color 0.18s ease;
  }

  .post:hover {
    border-color: var(--accent);
    color: inherit;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    font-size: 13px;
    color: var(--ink-subtle);
  }

  .post__tag {
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 4px 11px;
    color: var(--ink-body);
  }

  .post__draft {
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    padding: 4px 11px;
  }

  .post__title {
    font-size: 22px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 16px 0 10px;
  }

  .post__excerpt {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
  }

  @media (max-width: 780px) {
    .wrap {
      padding-block: 48px 64px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
