---
/**
 * Изборът на час — целият без JavaScript.
 *
 * Три стъпки, всяка от които е адрес: `?date=` избира ден, `&slot=` избира
 * час, формата потвърждава. Затова работи с изключен JavaScript, помни се в
 * историята на браузъра и се споделя като връзка — гласовият агент може да
 * прати на човека готов адрес за конкретен час.
 *
 * Дните са РЕШЕТКА, не списък. Списъкът показваше само дните със свободни
 * часове и от него не личеше формата на заетостта: „тази седмица е пълна,
 * другата е празна“ е решение, което се взима с един поглед върху календар и
 * с четене върху списък. Заетите дни стоят на мястото си, изгасени.
 *
 * Страницата НЕ се предрендерира. Свободните часове се менят всеки път и
 * статична версия би показвала вчерашното състояние.
 */
import { localeOf } from '../i18n/index.ts';
import { ui } from '../i18n/content.ts';
import { TIMEZONE } from '../data/booking.mjs';
import { availability, bookingByToken, datesInWindow, type Slot } from '../lib/booking.ts';
import {
  longDateLabel,
  zonedDateKey,
  zonedTimeLabel,
  zoneAbbreviation,
  parseDateKey,
} from '../lib/time.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang).booking;

const params = Astro.url.searchParams;
const db = Astro.locals.runtime?.env?.BOOKINGS;
const now = Date.now();
const DAY = 86_400_000;

/** Адрес на същата страница с други параметри — пази езиковия префикс. */
function withParams(next: Record<string, string | undefined>): string {
  const url = new URL(Astro.url);
  url.search = '';
  for (const [key, value] of Object.entries(next)) {
    if (value) url.searchParams.set(key, value);
  }
  return url.pathname + url.search;
}

/* ---------- календарната решетка ----------
 *
 * Датите се смятат като КАЛЕНДАРНИ, не като моменти: `Date.UTC` върху
 * годината, месеца и деня и събиране по 24 часа. Така смяната на лятното
 * часово време не може да измести ден — тя мести моменти, а тук няма нито
 * един. Превръщането в момент вече е свършено в `slotGrid`.
 */
const pad = (n: number) => String(n).padStart(2, '0');
const utcOfKey = (key: string) => {
  const p = parseDateKey(key)!;
  return Date.UTC(p.year, p.month - 1, p.day);
};
/*
 * `month: 'short'` на български връща „09“, не „сеп“ — ICU няма съкратени
 * имена за българските месеци. Затова пълното име, отрязано на три знака:
 * „септември“ → „сеп“. Английският минава през същия път и дава „Sep“, което
 * е и правилното съкращение там.
 */
const monthLong = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'bg-BG', { month: 'long' });
const monthTag = (at: number) => monthLong.format(new Date(at)).slice(0, 3);
const keyOfUtc = (ms: number) => {
  const d = new Date(ms);
  return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;
};
/** Понеделникът е нулевата колона; `getUTCDay` брои от неделя. */
const mondayFirst = (ms: number) => (new Date(ms).getUTCDay() + 6) % 7;

type Cell = {
  date: string;
  day: number;
  free: number;
  isToday: boolean;
  /** Кратко име на месеца — само на първо число, иначе празно. */
  month: string;
  /**
   * Денят се запълва. Сметнато ТУК, а не в разметката: компилаторът на Astro
   * чете `<=` вътре в шаблон като начало на етикет и се спъва.
   */
  scarce: boolean;
  /** Извън прозореца за запазване — не е ден, който изобщо се предлага. */
  outside: boolean;
};

/**
 * Под колко свободни часа денят се смята за „запълва се“.
 *
 * Броячът се показва САМО тогава. Изписан на всяка клетка, той се четеше
 * като втора дата — „19“ и отдолу „10“ изглеждат като период, не като
 * наличност. А когато денят е почти празен, числото и без това не казва
 * нищо ново: клетката вече е бяла и се натиска.
 */
const SCARCE = 3;

type View =
  | { kind: 'unavailable' }
  | { kind: 'done'; when: string; token: string; cancelled: boolean; mailed: boolean }
  | { kind: 'notFound' }
  | { kind: 'confirm'; slot: Slot; date: string }
  | { kind: 'pick'; weeks: Cell[][]; date: string | null; slots: Slot[]; any: boolean };

let view: View = { kind: 'unavailable' };
const error = params.get('error') ?? '';

if (db) {
  const token = params.get('done') ?? params.get('cancelled');

  if (token) {
    const booking = await bookingByToken(db, token);
    view = booking
      ? {
          kind: 'done',
          token: booking.token,
          cancelled: booking.status === 'cancelled',
          /*
           * Казва се, че писмо е тръгнало, САМО ако наистина е имало с какво:
           * връзка за поща до непознат адрес и адрес, на който да се прати.
           * Часовете по телефона често нямат имейл, а бетата може да е
           * изключена — обещание за писмо, което не идва, е по-лошо от нищо.
           */
          mailed: Boolean(Astro.locals.runtime?.env?.SEND_TO_VISITOR && booking.email),
          when: `${longDateLabel(booking.start_utc, TIMEZONE, lang)}, ${zonedTimeLabel(booking.start_utc, TIMEZONE)}`,
        }
      : { kind: 'notFound' };
  } else {
    const days = await availability(db, now);
    const freeBy = new Map(days.map((d) => [d.date, d.slots.length]));

    const wanted = params.get('date');
    const date = wanted && parseDateKey(wanted) ? wanted : null;
    const day = date ? days.find((entry) => entry.date === date) : null;
    const slotParam = Number(params.get('slot'));
    const chosen =
      day && Number.isFinite(slotParam)
        ? day.slots.find((slot) => slot.startUtc === slotParam)
        : undefined;

    if (chosen && date) {
      view = { kind: 'confirm', slot: chosen, date };
    } else {
      // Решетката се разпъва до цели седмици, за да не увисват колони.
      const window = datesInWindow(now);
      const first = utcOfKey(window[0]);
      const last = utcOfKey(window[window.length - 1]);
      const from = first - mondayFirst(first) * DAY;
      const to = last + (6 - mondayFirst(last)) * DAY;
      const today = zonedDateKey(now, TIMEZONE);
      const inWindow = new Set(window);

      const weeks: Cell[][] = [];
      for (let ms = from; ms <= to; ms += 7 * DAY) {
        const week: Cell[] = [];
        for (let i = 0; i < 7; i++) {
          const at = ms + i * DAY;
          const key = keyOfUtc(at);
          const day = new Date(at).getUTCDate();
          week.push({
            date: key,
            day,
            free: freeBy.get(key) ?? 0,
            isToday: key === today,
            // Прозорецът е три седмици и почти винаги пресича месец. „31“ и
            // „1“ една до друга без надпис са неразбираеми.
            month: day === 1 ? monthTag(at) : '',
            scarce: (freeBy.get(key) ?? 0) > 0 && (freeBy.get(key) ?? 0) <= SCARCE,
            outside: !inWindow.has(key),
          });
        }
        weeks.push(week);
      }

      view = {
        kind: 'pick',
        weeks,
        date: day ? day.date : null,
        slots: day ? day.slots : [],
        any: days.length > 0,
      };
    }
  }
}

/** Съкратените имена на дните — от `Intl`, за да са верни и на двата езика. */
const weekdayNames = Array.from({ length: 7 }, (_, i) =>
  new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'bg-BG', { weekday: 'short' })
    // 5 януари 2026 е понеделник.
    .format(new Date(Date.UTC(2026, 0, 5 + i))),
);

const zone = zoneAbbreviation(now, TIMEZONE);
const step = view.kind === 'confirm' ? 3 : view.kind === 'pick' && view.date ? 2 : 1;
const steps = [t.stepDay, t.stepTime, t.stepConfirm];
const contactHref = lang === 'en' ? '/en/contact/' : '/contact/';
---

<div class="book">
  <div class="book__main">
    {error && <p class="alert" role="alert">{error}</p>}

    {
      (view.kind === 'pick' || view.kind === 'confirm') && (
        <ol class="steps" aria-label={t.eyebrow}>
          {steps.map((label, i) => (
            <li class:list={['steps__item', i + 1 === step && 'steps__item--now', i + 1 < step && 'steps__item--done']}>
              <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="steps__label">{label}</span>
            </li>
          ))}
        </ol>
      )
    }

    {
      view.kind === 'unavailable' && (
        <div class="empty">
          <p class="empty__text">{t.unavailable}</p>
          <a class="btn btn--primary" href={contactHref}>
            {t.contactInstead}
          </a>
        </div>
      )
    }

    {
      view.kind === 'notFound' && (
        <div class="empty">
          <p class="empty__text">{t.notFound}</p>
          <a class="btn btn--primary" href={withParams({})}>
            {t.pickDay}
          </a>
        </div>
      )
    }

    {
      view.kind === 'done' && (
        <div class:list={['ticket', view.cancelled && 'ticket--off']}>
          <p class="ticket__mark" aria-hidden="true">
            {view.cancelled ? '×' : '✓'}
          </p>
          <h2 class="ticket__title">{view.cancelled ? t.cancelledTitle : t.doneTitle}</h2>
          <p class="ticket__when">{view.when}</p>
          <p class="ticket__zone">{t.timezoneNote} ({zone})</p>
          <p class="ticket__lead">{view.cancelled ? t.cancelledLead : t.doneLead}</p>
          {!view.cancelled && view.mailed && <p class="ticket__mailed">{t.doneMailed}</p>}

          {!view.cancelled && (
            <div class="ticket__actions">
              <a class="btn btn--primary" href={`/api/booking/${view.token}.ics`}>
                {t.addToCalendar}
              </a>
              <form method="POST" action="/api/booking/cancel">
                <input type="hidden" name="token" value={view.token} />
                <input type="hidden" name="locale" value={lang} />
                <button class="ticket__cancel" type="submit">
                  {t.cancelLink}
                </button>
              </form>
            </div>
          )}

          {view.cancelled && (
            <a class="btn btn--primary ticket__again" href={withParams({})}>
              {t.pickDay}
            </a>
          )}
        </div>
      )
    }

    {
      view.kind === 'pick' &&
        (!view.any ? (
          <div class="empty">
            <p class="empty__text">{t.noSlots}</p>
            <a class="btn btn--primary" href={contactHref}>
              {t.contactInstead}
            </a>
          </div>
        ) : (
          <>
            <div class="cal">
              <div class="cal__head" aria-hidden="true">
                {weekdayNames.map((name) => (
                  <span class="cal__wd">{name}</span>
                ))}
              </div>

              {view.weeks.map((week) => (
                <div class="cal__week">
                  {week.map((cell) =>
                    cell.free > 0 ? (
                      <a
                        class:list={[
                          'cell',
                          'cell--open',
                          cell.date === view.date && 'cell--on',
                          cell.isToday && 'cell--today',
                        ]}
                        href={withParams({ date: cell.date })}
                        aria-label={`${longDateLabel(new Date(cell.date + 'T12:00:00Z').getTime(), TIMEZONE, lang)} — ${cell.free} ${t.free}`}
                        aria-current={cell.date === view.date ? 'true' : undefined}
                      >
                        <span class="cell__n">{cell.day}</span>
                        {cell.month ? (
                          <span class="cell__tag">{cell.month}</span>
                        ) : cell.scarce ? (
                          <span class="cell__tag cell__tag--few">{cell.free}</span>
                        ) : null}
                      </a>
                    ) : (
                      <span
                        class:list={['cell', 'cell--shut', cell.isToday && 'cell--today']}
                        aria-hidden="true"
                      >
                        <span class="cell__n">{cell.day}</span>
                        {cell.month && <span class="cell__tag">{cell.month}</span>}
                      </span>
                    ),
                  )}
                </div>
              ))}
            </div>

            <p class="cal__zone">
              {t.timezoneNote} ({zone})
            </p>

            {view.date && view.slots.length > 0 && (
              <div class="times">
                <p class="times__day">
                  {longDateLabel(view.slots[0].startUtc, TIMEZONE, lang)}
                </p>
                <ul class="times__list">
                  {view.slots.map((slot, i) => (
                    <li style={`--i: ${i}`}>
                      <a
                        class="time"
                        href={withParams({ date: view.date!, slot: String(slot.startUtc) })}
                      >
                        {zonedTimeLabel(slot.startUtc, TIMEZONE)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </>
        ))
    }

    {
      view.kind === 'confirm' && (
        <>
          <div class="chosen">
            <div>
              <p class="chosen__day">{longDateLabel(view.slot.startUtc, TIMEZONE, lang)}</p>
              <p class="chosen__time">
                {`${zonedTimeLabel(view.slot.startUtc, TIMEZONE)}–${zonedTimeLabel(view.slot.endUtc, TIMEZONE)}`}
                <span class="chosen__zone">{zone}</span>
              </p>
            </div>
            <a class="chosen__change" href={withParams({ date: view.date })}>
              {t.changeTime}
            </a>
          </div>

          <form class="form" method="POST" action="/api/book">
            <input type="hidden" name="start" value={String(view.slot.startUtc)} />
            <input type="hidden" name="locale" value={lang} />
            {/* Примамка за ботове — човек не я вижда и не я попълва. */}
            <div class="form__trap" aria-hidden="true">
              <label>
                Website
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div class="form__row">
              <label class="field">
                <span class="field__label">
                  {t.name} <span class="field__req">{t.required}</span>
                </span>
                <input class="field__input" type="text" name="name" required maxlength="120" autocomplete="name" />
              </label>

              <label class="field">
                <span class="field__label">
                  {t.email} <span class="field__req">{t.required}</span>
                </span>
                <input class="field__input" type="email" name="email" required maxlength="180" autocomplete="email" />
              </label>
            </div>

            <label class="field">
              <span class="field__label">{t.phone}</span>
              <input class="field__input" type="tel" name="phone" maxlength="40" autocomplete="tel" />
            </label>

            <label class="field">
              <span class="field__label">{t.note}</span>
              <textarea class="field__input field__input--area" name="note" rows="3" maxlength="1200" />
            </label>

            <button class="btn btn--primary form__submit" type="submit">
              {t.submit}
            </button>
          </form>
        </>
      )
    }
  </div>

  {
    (view.kind === 'pick' || view.kind === 'confirm') && (
      <aside class="side">
        <p class="side__title">{t.asideTitle}</p>
        <ul class="side__list">
          {t.asideItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <p class="side__note">
          {t.asideNote} <a href={contactHref}>{t.contactInstead}</a>
        </p>
      </aside>
    )
  }
</div>

<style>
  .book {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .book__main {
    min-width: 0;
  }

  .alert {
    background: var(--accent-soft);
    border-left: 3px solid var(--accent);
    border-radius: 0 12px 12px 0;
    padding: 14px 18px;
    margin: 0 0 28px;
    font-size: 15.5px;
    color: var(--ink);
  }

  /* ---------- стъпките ---------- */

  .steps {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    margin: 0 0 30px;
    padding: 0 0 18px;
    border-bottom: 1px solid var(--line);
  }

  .steps__item {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--ink-faint);
  }

  .steps__n {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .steps__label {
    font-size: 14px;
    font-weight: 600;
  }

  .steps__item--done {
    color: var(--ink-muted);
  }

  /* Само текущата стъпка носи теракота — тя е единственото място, на което
     читателят действа в момента. */
  .steps__item--now {
    color: var(--accent);
  }

  /* ---------- календарът ---------- */

  /*
   * Календарът е ограничен по ширина. Разпънат по цялата колона, клетките
   * стават по 150 пиксела и решетката спира да прилича на календар — по-скоро
   * на плочки. 600 пиксела дават клетка от около 80, което е размерът, на
   * който човек чете месец с един поглед.
   */
  .cal {
    display: grid;
    gap: 6px;
    max-width: 600px;
  }

  .cal__head,
  .cal__week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
  }

  .cal__wd {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-subtle);
    text-align: center;
    padding-bottom: 4px;
  }

  .cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    aspect-ratio: 1;
    border-radius: 12px;
    border: 1px solid transparent;
    font-variant-numeric: tabular-nums;
  }

  .cell__n {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    line-height: 1;
  }

  /* Месецът при смяна и броячът при недостиг делят едно място — и двете са
     дребни надписи под числото и никога не се появяват заедно. */
  .cell__tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink-subtle);
  }

  /* Оранжевото тук значи „бърза се“, а не „натисни“ — затова е само на
     ЧИСЛОТО, а клетката около него си остава каквато е. */
  .cell__tag--few {
    color: var(--accent);
  }

  /* Затворените дни ОСТАВАТ на мястото си. Изваждането им би преномерирало
     решетката и „вторник“ би се озовал в колоната на четвъртък. */
  .cell--shut {
    background: transparent;
    color: var(--ink-faint);
  }

  .cell--open {
    background: var(--panel);
    border-color: var(--line);
    color: var(--ink);
    transition:
      border-color 0.16s ease,
      transform 0.16s ease,
      box-shadow 0.16s ease;
  }

  .cell--open:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .cell--open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Избраният ден е плътен, не само очертан — иначе на решетка от бели
     квадрати рамката се губи. */
  .cell--on,
  .cell--on:hover {
    background: var(--dark);
    border-color: var(--dark);
    color: var(--dark-ink);
    transform: none;
  }

  .cell--on .cell__tag {
    color: var(--dark-ink-subtle);
  }

  /* Днешният ден се маркира с точка, а не с цвят: цветът тук вече значи
     „свободно“ и „избрано“. */
  .cell--today {
    position: relative;
  }

  .cell--today::after {
    content: '';
    position: absolute;
    bottom: 6px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }

  .cell--open.cell--today::after {
    background: var(--accent);
    opacity: 1;
  }

  .cal__zone {
    margin: 16px 0 0;
    font-size: 13px;
    color: var(--ink-subtle);
  }

  /* ---------- часовете ---------- */

  .times {
    max-width: 600px;
    margin-top: 26px;
    padding: clamp(20px, 3vw, 26px);
    background: var(--bg-sand-strong);
    border-radius: 18px;
  }

  /*
   * Само ПЪРВАТА буква, не всяка дума. `text-transform: capitalize` дава
   * „Сряда, 19 Август“, а на български месецът се пише с малка. Intl връща
   * деня с малка, затова главната трябва да дойде оттук.
   */
  .times__day {
    font-family: var(--font-display);
    font-size: 16px;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  .times__day::first-letter,
  .chosen__day::first-letter,
  .ticket__when::first-letter {
    text-transform: uppercase;
  }

  .times__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
    gap: 8px;
  }

