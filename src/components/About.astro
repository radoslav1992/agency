---
/**
 * „За мен“.
 *
 * Портретът се върна тук — със същата рамка, която носеше в hero-а: топло
 * петно отзад, мека сянка и табелка с името. В hero-а той отговаряше на
 * „кой“, докато читателят още пита „какво“; тук въпросът вече е зададен и
 * снимката е на място.
 *
 * Няма подпис под снимката: предишният описваше лекция на конференция и
 * след смяната на кадъра щеше да описва нещо, което не се вижда. Името и
 * длъжността ги казва табелката.
 */
import { Image } from 'astro:assets';
import portrait from '../assets/hero-portrait.png';
import { localeOf } from '../i18n/index.ts';
import { content, owner, projects as projectsFor, ui } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const who = owner(lang);
const { ABOUT } = content(lang);
const { PROJECTS } = projectsFor(lang);

/**
 * Броят проекти се смята от списъка, а не се преписва на ръка — точно това
 * разминаване създаде твърдението „7 собствени продукта“, което вече не
 * беше вярно. Добавя се към статистиките, за да не се дублира лентата
 * „Опит:“, която го повтаряше над същия текст.
 */
const clientCount = PROJECTS.filter((p) => !p.own).length;
const stats = [...ABOUT.stats, t.about.projectsStat(PROJECTS.length, clientCount)];
---

<section id="about" class="about">
  <div class="container inner">
    <figure class="figure">
      <div class="figure__blob" aria-hidden="true"></div>
      <Image
        class="figure__image"
        src={portrait}
        alt={who.name}
        widths={[400, 620, 900]}
        sizes="(max-width: 900px) 90vw, 460px"
        loading="lazy"
      />
      <div class="figure__badge">
        <p class="figure__badge-name">{who.name}</p>
        <p class="figure__badge-role">{who.role}</p>
      </div>
    </figure>

    <div class="copy">
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h2 class="section-title">{ABOUT.heading}</h2>
      {ABOUT.paragraphs.map((text) => <p class="copy__text">{text}</p>)}

      <div class="stats">
        {
          stats.map((stat) => (
            <div class="stat">
              {/* Числата стоят едри; думите се смаляват, за да се поберат. */}
              <p class:list={['stat__value', stat.value.length > 4 && 'stat__value--word']}>
                {stat.value}
              </p>
              <p class="stat__label">{stat.label}</p>
            </div>
          ))
        }
      </div>

      <ul class="skills">
        {ABOUT.skills.map((skill) => <li class="pill pill--outline">{skill}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--bg-sand-strong);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    padding-block: 88px;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 60px;
    align-items: center;
  }

  /* ---------- портретът, с рамката от hero-а ---------- */

  .figure {
    margin: 0;
    position: relative;
    min-width: 0;
  }

  /*
   * Петното е с тон по-тъмно от фона на секцията, не в `--bg-blush` както в
   * hero-а. Там то лежеше върху най-светлия фон (`--bg`) и се четеше; тук
   * фонът вече е топъл (`--bg-sand-strong`) и двата цвята се различаваха с
   * по-малко от процент — рамката просто изчезваше.
   */
  .figure__blob {
    position: absolute;
    inset: 12% -6% -2% 4%;
    background: var(--line);
    border-radius: 28px;
  }

  .figure__image {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
    filter: var(--shadow-hero);
  }

  .figure__badge {
    position: absolute;
    left: -12px;
    bottom: 14px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 10px 14px;
    box-shadow: var(--shadow-card);
  }

  .figure__badge-name {
    font-weight: 700;
    font-size: 13.5px;
    margin: 0;
  }

  .figure__badge-role {
    font-size: 12px;
    color: var(--ink-muted);
    margin: 2px 0 0;
  }

  .copy__text {
    font-size: 17.5px;
    line-height: 1.62;
    color: var(--ink-soft);
    margin: 20px 0 0;
  }

  .copy__text + .copy__text {
    margin-top: 16px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 14px;
    margin-top: 28px;
  }

  .stat {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 16px 18px;
    /* Кутията става мерна единица за текста си — виж `.stat__value`. */
    container-type: inline-size;
  }

  .stat__value {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    margin: 0;
    /* Клапан, ако някога влезе дума, по-дълга и от смаления размер. */
    overflow-wrap: break-word;
  }

  /*
   * „Докторант“ е дума в поле, оразмерено за „6+“ — при 24px излизаше с
   * около 50px извън кутията. Едно общо смаляване щеше да отнеме тежестта
   * и на числата, затова се смаляват само стойностите, които не са число.
   * Мярката е кутията (`cqi`), не екранът, за да важи и когато картите
   * се преподредят.
   */
  .stat__value--word {
    font-size: clamp(14px, 11cqi, 19px);
    line-height: 1.2;
  }

  .stat__label {
    font-size: 14px;
    color: var(--ink-muted);
    margin: 4px 0 0;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-block: 56px;
    }

    .figure {
      /* Петното се подава с 6% вдясно от снимката. Без този резерв то
         опира ръба на екрана и страницата тръгва настрани. */
      max-width: min(420px, 100% - 26px);
      margin-inline: auto;
    }

    /* Табелката не виси извън екрана, когато снимката е центрирана. */
    .figure__badge {
      left: 0;
    }
  }

  @media (max-width: 460px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>
