---
import { SERVICES, SECONDARY_SERVICES } from '../data/content.ts';
---

<section id="services" class="services container">
  <header class="head">
    <div>
      <p class="eyebrow">Услуги</p>
      <h2 class="section-title">С какво мога да помогна</h2>
    </div>
    <p class="head__note">
      Технологията е средство. Целта е процесът да стане по-бърз и да не зависи от това кой е на
      работа днес.
    </p>
  </header>

  <div class="grid">
    {
      SERVICES.map((service) => (
        <article
          class:list={[
            'service',
            service.variant === 'dark' && 'service--dark',
            service.variant === 'wide' && 'service--wide',
          ]}
        >
          <p class="service__number">{service.number}</p>
          <h3 class="service__title">{service.title}</h3>
          {service.body && <p class="service__body">{service.body}</p>}
          {service.problem && (
            <dl class="service__rows">
              <div class="service__row">
                <dt>Проблемът</dt>
                <dd>{service.problem}</dd>
              </div>
              <div class="service__row">
                <dt>Решението</dt>
                <dd>{service.solution}</dd>
              </div>
              {service.change && (
                <div class="service__row">
                  <dt>Какво се променя</dt>
                  <dd set:html={service.change} />
                </div>
              )}
            </dl>
          )}
          {service.points && service.points.length > 0 && (
            <ul class="service__points">
              {service.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          )}
          {service.tags && service.tags.length > 0 && (
            <ul class="service__tags">
              {service.tags.map((tag) => (
                <li class="pill">{tag}</li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>

  <div class="grid grid--secondary">
    {
      SECONDARY_SERVICES.map((service) => (
        <article class="service service--secondary">
          <p class="service__number">{service.number}</p>
          <h3 class="service__title">{service.title}</h3>
          {service.body && <p class="service__body">{service.body}</p>}
          {service.problem && (
            <dl class="service__rows">
              <div class="service__row">
                <dt>Проблемът</dt>
                <dd>{service.problem}</dd>
              </div>
              <div class="service__row">
                <dt>Решението</dt>
                <dd>{service.solution}</dd>
              </div>
              {service.change && (
                <div class="service__row">
                  <dt>Какво се променя</dt>
                  <dd set:html={service.change} />
                </div>
              )}
            </dl>
          )}
          {service.points && service.points.length > 0 && (
            <ul class="service__points">
              {service.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .services {
    padding-block: 88px 20px;
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .head__note {
    font-size: 16px;
    color: var(--ink-muted);
    max-width: 380px;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 40px;
  }

  .service {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 28px;
    transition: border-color 0.18s ease;
  }

  .service:hover {
    border-color: var(--accent);
  }

  .service--wide {
    grid-column: span 2;
  }

  .grid--secondary {
    grid-template-columns: repeat(2, 1fr);
    margin-top: 18px;
  }

  /* По-тихи карти — сайтовете и обученията не са първото послание. */
  .service--secondary {
    background: var(--bg-sand);
    padding: 22px 24px;
  }

  .service--secondary .service__title {
    font-size: 18px;
  }

  .service--secondary .service__body {
    font-size: 14.5px;
  }

  .service--dark {
    background: var(--dark);
    border-color: var(--dark);
    color: var(--dark-ink);
  }

  .service--dark:hover {
    border-color: var(--dark);
  }

  .service__number {
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--ink-faint);
    margin: 0;
  }

  .service--dark .service__number {
    color: var(--dark-number);
  }

  .service__title {
    font-size: 21px;
    letter-spacing: -0.02em;
    margin: 14px 0 10px;
  }

  .service--dark .service__title {
    color: #fff;
  }

  .service__body {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-body);
    margin: 0;
    max-width: 620px;
  }

  .service--dark .service__body {
    color: var(--dark-ink-muted);
  }

  .service__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .service__rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 14px 0 0;
  }

  .service__row dt {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .service__row dd {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-body);
    margin: 3px 0 0;
  }

  .service__row dd :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .service--dark .service__row dd {
    color: var(--dark-ink-muted);
  }

  .service__points {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 14px;
    color: var(--ink-muted);
  }

  .service__points li::before {
    content: '✓ ';
    color: var(--success, #34a853);
  }

  .service--dark .service__points {
    color: var(--dark-ink-muted);
  }

  .service--dark .pill {
    background: var(--dark-chip);
    color: var(--dark-ink-muted);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid--secondary {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .services {
      padding-block: 56px 16px;
    }

    .grid {
      grid-template-columns: 1fr;
      margin-top: 32px;
    }

    .service--wide {
      grid-column: auto;
    }
  }
</style>
