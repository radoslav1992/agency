---
import { TESTIMONIALS, PLACEHOLDER_TESTIMONIALS, initialsOf } from '../data/testimonials.ts';
---

<section class="testimonials container">
  <p class="eyebrow">Отзиви</p>
  <h2 class="section-title">Какво казват клиентите</h2>
  {PLACEHOLDER_TESTIMONIALS && <p class="note">Примерни текстове — заменяме ги с реалните ти отзиви.</p>}

  <div class:list={['grid', !PLACEHOLDER_TESTIMONIALS && 'grid--tight']}>
    {
      TESTIMONIALS.map((item) => (
        <figure class="quote">
          <blockquote class="quote__text">„{item.quote}“</blockquote>
          <figcaption class="quote__author">
            <span class="quote__avatar" aria-hidden="true">
              {initialsOf(item)}
            </span>
            <span>
              <span class="quote__name">{item.author}</span>
              <span class="quote__role">{item.role}</span>
              {item.project && (
                <span class="quote__project">
                  {item.project.url ? (
                    <a href={item.project.url} target="_blank" rel="noopener">
                      {item.project.name} ↗
                    </a>
                  ) : (
                    item.project.name
                  )}
                  {item.project.result && <span class="quote__result">{item.project.result}</span>}
                </span>
              )}
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .testimonials {
    padding-block: 88px;
  }

  .note {
    font-size: 15px;
    color: var(--ink-subtle);
    margin: 8px 0 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 36px;
  }

  .grid--tight {
    margin-top: 36px;
  }

  .quote {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 28px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .quote__text {
    font-size: 17px;
    line-height: 1.6;
    margin: 0;
    text-wrap: pretty;
  }

  .quote__author {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .quote__avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--bg-blush);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 14px;
    flex: none;
  }

  .quote__name {
    display: block;
    font-weight: 600;
    font-size: 14.5px;
  }

  .quote__role {
    display: block;
    font-size: 13px;
    color: var(--ink-subtle);
  }

  .quote__project {
    display: block;
    font-size: 13px;
    margin-top: 4px;
  }

  .quote__result {
    display: block;
    color: var(--ink-muted);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .testimonials {
      padding-block: 56px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
