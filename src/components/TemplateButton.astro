---
interface Props {
  href: string;
  round?: boolean;
  class?: string;
  /** `false` for server-rendered targets such as /booking/ — see BookingPicker. */
  prefetch?: boolean;
}
const { href, round = false, class: extra = '', prefetch = true } = Astro.props;
---

<a
  href={href}
  data-astro-prefetch={prefetch ? undefined : 'false'}
  class:list={[
    round ? 'tp-btn-rounded' : 'tp-btn-lg tp-round-26 tp-bg-common-black tp-text-common-white',
    'al-button',
    extra,
  ]}
  data-al-magnetic={round || undefined}
>
  <span class="al-button__arrow" aria-hidden="true">
    ↗
  </span>
  <span>
    <slot />
  </span>
</a>
