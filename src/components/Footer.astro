---
import BrandMark from './BrandMark.astro';
import { SITE } from '../data/site.mjs';
import { href as localised, localeOf } from '../i18n/index.ts';
import { brand, cta, legalName, location, nav, phone, ui } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const studio = brand(lang);
const where = location(lang);
const tel = phone(lang);
/* Същата навигация като горе плюс контактите — на английски анализаторът
   и блогът просто липсват, защото ги няма на този език. */
const links = [...nav(lang).filter((item) => item.href !== '/'), cta(lang)];

const year = new Date().getFullYear();
---

<footer class="al-template al-footer tp-bg-common-black">
  <div class="container">
    <div class="al-footer-top">
      <a class="al-footer-brand" href={localised('/', lang)}>
        <BrandMark size={62} loading="lazy" />
        <span>{studio.name}</span>
      </a>
      <a class="al-footer-invite" href={`mailto:${SITE.email}`}>
        {SITE.email} <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="al-footer-grid">
      <div>
        <h2>{where.full}</h2>
        <p>{legalName(lang)}</p>
        <p>{t.footer.reach}</p>
        <a href={tel.href}>{tel.label}</a>
        <a href={SITE.owner.linkedin} rel="me noopener" target="_blank">
          LinkedIn ↗
        </a>
      </div>
      <nav aria-label={t.footer.nav}>
        <h2>{t.footer.navTitle}</h2>
        {links.map((item) => (
          <a href={localised(item.href, lang)}>{item.label}</a>
        ))}
      </nav>
      <div>
        <h2>{t.footer.termsTitle}</h2>
        <a href={localised('/terms/', lang)}>{t.footer.terms}</a>
        <a href={localised('/privacy/', lang)}>{t.footer.privacy}</a>
        <a href={localised('/cookies/', lang)}>{t.footer.cookies}</a>
        <p>{t.footer.promise}</p>
      </div>
    </div>
    <div class="al-footer-bottom">
      <span>
        © {year} {studio.name}
        {t.footer.rights}
      </span>
      <span>{lang === 'en' ? 'Made with purpose.' : 'Създадено с цел.'}</span>
    </div>
  </div>
</footer>
