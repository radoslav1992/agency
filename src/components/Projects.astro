---
import ProjectCard from './ProjectCard.astro';
import { PROJECTS, PROJECTS_ON_HOME } from '../data/projects.ts';

const shown = PROJECTS.slice(0, PROJECTS_ON_HOME);
const hasMore = PROJECTS.length > shown.length;
const linkLabel = hasMore ? `Всички ${PROJECTS.length} проекта →` : 'Всички проекти →';
---

<section id="projects" class="projects container">
  <header class="head">
    <div>
      <p class="eyebrow">Kova Labs</p>
      <h2 class="section-title">Собствени продукти в реална експлоатация</h2>
      <p class="head__note">
        Не само разработвам за клиенти — създавам, пускам и поддържам собствени продукти. Всички
        работят в момента.
      </p>
    </div>
    <a class="head__link" href="/projects/">{linkLabel}</a>
  </header>

  <div class="grid">
    {shown.map((project, index) => <ProjectCard project={project} eager={index < 3} />)}
  </div>
</section>

<style>
  .projects {
    padding-block: 88px 0;
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .head__note {
    font-size: 15px;
    color: var(--ink-muted);
    max-width: 560px;
    margin: 10px 0 0;
  }

  .head__link {
    font-weight: 600;
    font-size: 15px;
    color: var(--accent);
    white-space: nowrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .projects {
      padding-block: 56px 0;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
