---
import { PROCESS, TERMS } from '../data/content.ts';
---

<section class="process container">
  <header class="head">
    <p class="eyebrow">Процес</p>
    <h2 class="section-title">Как протича работата</h2>
  </header>

  <ol class="steps">
    {
      PROCESS.map((step, index) => (
        <li class:list={['step', index === 0 && 'step--first']}>
          <p class="step__number">{step.number}</p>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__body">{step.body}</p>
        </li>
      ))
    }
  </ol>

  <div class="terms">
    <h3 class="terms__title">Важните условия — ясни още в началото</h3>
    {/* Акордеон, затворен по подразбиране — иначе яде половин екран. */}
    <div class="terms__list">
      {
        TERMS.map((term) => (
          <details class="term">
            <summary class="term__q">{term.title}</summary>
            <p class="term__a">{term.body}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .process {
    padding-block: 80px;
  }

  .head {
    margin-bottom: 26px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    border-top: 2px solid var(--line);
    padding-top: 18px;
  }

  .step--first {
    border-top-color: var(--ink);
  }

  .step__number {
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--accent);
    margin: 0;
  }

  .step__title {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: normal;
    margin: 8px 0;
  }

  .step__body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
  }

  .terms {
    margin-top: 44px;
    background: var(--bg-sand);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 28px;
  }

  .terms__title {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: normal;
    margin: 0 0 20px;
  }

  .terms__list {
    display: flex;
    flex-direction: column;
  }

  .term {
    border-top: 1px solid var(--line);
  }

  .term:last-child {
    border-bottom: 1px solid var(--line);
  }

  .term__q {
    cursor: pointer;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    padding: 14px 28px 14px 0;
    list-style: none;
    position: relative;
    transition: color 0.16s ease;
  }

  .term__q::-webkit-details-marker {
    display: none;
  }

  .term__q::after {
    content: '+';
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 18px;
    font-weight: 400;
    color: var(--ink-subtle);
    transition: transform 0.16s ease;
  }

  .term[open] .term__q::after {
    content: '−';
  }

  .term__q:hover {
    color: var(--accent);
  }

  .term__a {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
    padding: 0 0 16px;
    max-width: 640px;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .process {
      padding-block: 56px;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .terms {
      padding: 22px 20px;
    }
  }
</style>
