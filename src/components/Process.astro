---
import { PROCESS } from '../data/content.ts';
---

<section class="process container">
  <header class="head">
    <p class="eyebrow">Процес</p>
    <h2 class="section-title">Как работим</h2>
  </header>

  <ol class="steps">
    {
      PROCESS.map((step, index) => (
        <li class:list={['step', index === 0 && 'step--first']}>
          <p class="step__number">{step.number}</p>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__body">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .process {
    padding-block: 80px;
  }

  .head {
    margin-bottom: 26px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    border-top: 2px solid var(--line);
    padding-top: 18px;
  }

  .step--first {
    border-top-color: var(--ink);
  }

  .step__number {
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--accent);
    margin: 0;
  }

  .step__title {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: normal;
    margin: 8px 0;
  }

  .step__body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .process {
      padding-block: 56px;
    }

    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
