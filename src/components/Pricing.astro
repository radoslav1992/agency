---
import { PLANS } from '../data/content.ts';
---

<section class="pricing">
  <div class="container inner">
    <p class="eyebrow">Пакети</p>
    <h2 class="section-title">Ориентировъчни цени</h2>
    <p class="lead">
      Всеки проект е различен, но за да имаш представа още преди да пишеш — ето откъде тръгваме.
    </p>

    <div class="grid">
      {
        PLANS.map((plan) => (
          <article class:list={['plan', plan.featured && 'plan--featured']}>
            {plan.badge && <span class="plan__badge">{plan.badge}</span>}
            <h3 class="plan__name">{plan.name}</h3>
            <p class="plan__pitch">{plan.pitch}</p>
            <p class="plan__price">{plan.price}</p>
            {plan.timeline && <p class="plan__timeline">{plan.timeline}</p>}
            <ul class="plan__features">
              {plan.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="footnote">
      Срокът зависи от обхвата и го фиксирам заедно с цената — в
      <a href="/blog/oferta-na-edna-stranica/">оферта на една страница</a>, преди да започнем.
    </p>
  </div>
</section>

<style>
  .pricing {
    background: var(--dark);
    color: var(--dark-ink);
  }

  .inner {
    padding-block: 88px;
  }

  .section-title {
    color: #fff;
  }

  .lead {
    font-size: 15.5px;
    color: var(--dark-ink-subtle);
    margin: 8px 0 38px;
    max-width: 560px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .plan {
    background: var(--dark-card);
    border: 1px solid var(--dark-line);
    border-radius: 22px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .plan--featured {
    background: var(--dark-card-featured);
    border-color: var(--accent);
  }

  .plan__badge {
    position: absolute;
    top: -12px;
    left: 30px;
    background: var(--accent);
    color: #fff;
    font-size: 12.5px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 999px;
  }

  .plan__name {
    font-size: 20px;
    margin: 0;
    color: #fff;
  }

  .plan__pitch {
    font-size: 14.5px;
    color: var(--dark-ink-subtle);
    margin: 10px 0 0;
  }

  .plan__price {
    font-family: var(--font-display);
    font-size: 30px;
    margin: 22px 0 4px;
    color: #fff;
  }

  .footnote {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--dark-ink-subtle);
    margin: 26px 0 0;
    max-width: 620px;
  }

  .footnote a {
    color: var(--dark-ink-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footnote a:hover {
    color: #fff;
  }

  .plan__timeline {
    font-size: 13px;
    color: var(--dark-ink-faint);
    margin: 0;
  }

  .plan__features {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14.5px;
    color: var(--dark-ink-muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .inner {
      padding-block: 56px;
    }
  }
</style>
