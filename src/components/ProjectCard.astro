---
import { Image } from 'astro:assets';
import { domainOf, initialOf, slugOf, type Project } from '../data/projects.ts';

interface Props {
  project: Project;
  /** The first cards on screen should not lazy-load. */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;

/**
 * Screenshots are optional and matched by file name: drop
 * `src/assets/projects/<slug>.png` (or .jpg/.webp) and the card picks it up.
 * A glob keeps a missing file from breaking the build, which a static
 * `import` would.
 */
const shots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const slug = slugOf(project);
const shot = Object.entries(shots).find(
  ([path]) => path.split('/').pop()?.replace(/\.\w+$/, '') === slug,
)?.[1].default;
---

<a class:list={['project', shot && 'project--shot']} href={project.url} target="_blank" rel="noopener">
  {
    shot && (
      <span class="project__shot">
        <Image
          src={shot}
          alt={project.alt ?? `Екран от ${project.name}`}
          widths={[380, 560, 760]}
          sizes="(max-width: 680px) 90vw, (max-width: 980px) 45vw, 360px"
          loading={eager ? 'eager' : 'lazy'}
        />
      </span>
    )
  }

  <span class="project__head">
    {!shot && <span class="project__mark" aria-hidden="true">{initialOf(project)}</span>}
    <span class="project__domain">{domainOf(project)}</span>
    <span class="project__arrow" aria-hidden="true">↗</span>
  </span>

  <h3 class="project__name">{project.name}</h3>
  <p class="project__tagline">{project.tagline}</p>

  <span class="project__foot">
    <span class:list={['pill', 'pill--origin', project.own && 'pill--own']}>
      {project.own ? 'Собствен продукт' : 'Клиентски проект'}
    </span>
    {project.tags.map((tag) => <span class="pill">{tag}</span>)}
    {project.year && <span class="project__year">{project.year}</span>}
  </span>
</a>

<style>
  .project {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 26px 26px 24px;
    color: inherit;
    transition:
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .project:hover {
    border-color: var(--accent);
    color: inherit;
    transform: translateY(-2px);
  }

  /* With a screenshot the image sits flush to the card edges. */
  .project--shot {
    padding: 0 0 24px;
    overflow: hidden;
  }

  .project__shot {
    display: block;
    background: var(--bg-sand);
    border-bottom: 1px solid var(--line);
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .project__shot :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    /* Anchor to the top so the hero of each site stays visible. */
    object-position: top center;
    transition: transform 0.4s ease;
  }

  .project:hover .project__shot :global(img) {
    transform: scale(1.02);
  }

  .project__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .project--shot .project__head {
    padding: 20px 26px 0;
  }

  .project__mark {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--bg-blush);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
    flex: none;
  }

  .project:hover .project__mark {
    background: var(--accent);
    color: #fff;
  }

  .project__domain {
    font-size: 13px;
    color: var(--ink-subtle);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project__arrow {
    margin-left: auto;
    font-size: 14px;
    color: var(--ink-faint);
    transition: color 0.18s ease;
  }

  .project:hover .project__arrow {
    color: var(--accent);
  }

  .project__name {
    font-size: 19px;
    letter-spacing: -0.02em;
    margin: 18px 0 8px;
  }

  .project__tagline {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0 0 20px;
  }

  .project--shot :is(.project__name, .project__tagline) {
    padding-inline: 26px;
  }

  .project--shot .project__name {
    margin-top: 14px;
  }

  .project__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin-top: auto;
  }

  .project--shot .project__foot {
    padding-inline: 26px;
  }

  .project__year {
    font-size: 12.5px;
    color: var(--ink-subtle);
    margin-left: auto;
  }

  /* Клиентски проект vs собствен продукт — най-важният етикет на картата. */
  .pill--origin {
    background: var(--accent);
    color: #fff;
    font-weight: 600;
  }

  .pill--own {
    background: var(--chip);
    color: var(--ink-muted);
    font-weight: 500;
  }
</style>
