---
/**
 * „Не говоря за AI. Строя го.“ — четвъртото движение.
 *
 * Заменя решетката от три еднакви карти с три едри редуващи се блока, всеки
 * с екранна снимка на живия продукт. Разликата не е украса: картите се
 * четяха като списък с твърдения, а редовете се четат като доказателства,
 * защото снимката и адресът стоят до тях.
 *
 * Маркерът „собствен продукт / клиентски проект“ остава на всеки блок. Той
 * е разликата между доказателство и реклама и не отпада заради дизайна.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { href as localised, localeOf } from '../i18n/index.ts';
import { cases, projects as projectsFor, ui } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const { PRODUCTS_FEATURED } = cases(lang);
const { PROJECTS } = projectsFor(lang);

/**
 * Снимките се намират по име на файла, също като в `ProjectCard`: домейнът
 * без разширението е ключът (`routinly.org` → `routinly.png`). Глобът пази
 * липсващ файл да не счупи build-а, което статичният `import` не прави.
 */
const shots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

function shotFor(url: string): ImageMetadata | undefined {
  const slug = url
    .replace(/^https?:\/\//, '')
    .replace(/\/$/, '')
    .replace(/\.[^.]+$/, '');
  return Object.entries(shots).find(
    ([path]) => path.split('/').pop()?.replace(/\.\w+$/, '') === slug,
  )?.[1].default;
}

const domainOf = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<section id="proof" class="proof">
  <div class="container">
    <header class="proof__head">
      <p class="eyebrow proof__eyebrow">{t.proof.eyebrow}</p>
      <h2 class="proof__title">{t.proof.title}</h2>
      <p class="proof__lead">{t.proof.lead}</p>
    </header>

    <div class="proof__list">
      {
        PRODUCTS_FEATURED.map((item, i) => {
          const shot = shotFor(item.url);
          return (
            <article class="work" style={`--i: ${i}`}>
              <div class="work__media">
                {shot ? (
                  <a class="work__frame" href={item.url} target="_blank" rel="noopener">
                    <Image
                      src={shot}
                      alt={`${lang === 'en' ? 'A screen from' : 'Екран от'} ${item.name}`}
                      widths={[420, 680, 940]}
                      sizes="(max-width: 900px) 90vw, 520px"
                      loading="lazy"
                    />
                  </a>
                ) : (
                  <div class="work__frame work__frame--empty" aria-hidden="true" />
                )}
              </div>

              <div class="work__body">
                <p class="work__meta">
                  <span class="work__n">{String(i + 1).padStart(2, '0')}</span>
                  <span class:list={['work__origin', item.own && 'work__origin--own']}>
                    {item.own ? t.products.own : t.products.client}
                  </span>
                </p>

                <h3 class="work__name">
                  <a href={item.url} target="_blank" rel="noopener">
                    {item.name}
                    <span class="work__ext" aria-hidden="true">↗</span>
                  </a>
                </h3>

                <p class="work__takeaway">{item.takeaway}</p>

                <dl class="work__rows">
                  <div>
                    <dt>{t.products.problem}</dt>
                    <dd>{item.problem}</dd>
                  </div>
                  <div>
                    <dt>{t.products.solution}</dt>
                    <dd>{item.solution}</dd>
                  </div>
                  <div>
                    <dt>{t.products.how}</dt>
                    <dd>{item.under}</dd>
                  </div>
                </dl>

                <a class="work__open" href={item.url} target="_blank" rel="noopener">
                  {t.proof.open} {domainOf(item.url)} ↗
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="proof__foot">
      <a class="proof__all" href={localised('/projects/', lang)}>{t.proof.all(PROJECTS.length)}</a>
    </p>
  </div>
</section>

<style>
  .proof {
    background: var(--dark);
    color: var(--dark-ink);
    padding-block: clamp(76px, 11vw, 148px);
  }

  .proof__head {
    margin-bottom: clamp(48px, 7vw, 92px);
  }

  .proof__eyebrow {
    color: var(--dark-ink-subtle);
  }

  .proof__title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5.4vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin: 16px 0 0;
    color: var(--dark-ink);
    /*
     * Мярката е в `em`, тоест спрямо СОБСТВЕНИЯ размер на заглавието.
     * `ch` върху обвивката се меря спрямо шрифта на тялото (16px) и
     * смачкваше заглавието от два реда на пет.
     */
    max-width: 14em;
  }

  .proof__lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--dark-ink-muted);
    margin: 22px 0 0;
    max-width: 46ch;
  }

  /* ---------- един проект ---------- */

  .work {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  .work + .work {
    margin-top: clamp(64px, 9vw, 128px);
    padding-top: clamp(64px, 9vw, 128px);
    border-top: 1px solid var(--dark-line);
  }

  /* Редуване: вторият проект обръща реда, за да не е списък от еднакви редове. */
  .work:nth-child(even) .work__media {
    order: 2;
  }

  .work__frame {
    display: block;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--dark-line);
    background: var(--dark-card);
    aspect-ratio: 16 / 11;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .work__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .work:hover .work__frame {
    transform: translateY(-6px);
  }

  .work__meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 16px;
  }

  .work__n {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: var(--dark-number);
  }

  .work__origin {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--dark-ink-subtle);
    border: 1px solid var(--dark-line);
    border-radius: 999px;
    padding: 5px 11px;
  }

  /* Разликата „собствен / клиентски“ е важна и остава — но се носи от
     яркостта, не от теракотата, която пази за натискане. */
  .work__origin--own {
    color: var(--dark-ink);
    border-color: var(--dark-ink-faint);
  }

  .work__name {
    font-size: clamp(28px, 4.2vw, 50px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .work__name a {
    color: var(--dark-ink);
    transition: color 0.18s ease;
  }

  .work__name a:hover {
    color: var(--accent);
  }

  .work__ext {
    font-size: 0.42em;
    vertical-align: super;
    color: var(--dark-number);
  }

  .work__takeaway {
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.45;
    /* Кремаво върху тъмно е достатъчно силно; изводът няма нужда от цвят,
       за да е първото прочетено в блока. */
    color: var(--dark-ink);
    margin: 16px 0 0;
    max-width: 34ch;
  }

  .work__rows {
    margin: 26px 0 0;
    display: grid;
    gap: 16px;
  }

  .work__rows dt {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dark-ink-faint);
    margin-bottom: 5px;
  }

  .work__rows dd {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--dark-ink-muted);
    max-width: 48ch;
  }

  .work__open {
    display: inline-block;
    margin-top: 26px;
    font-weight: 600;
    font-size: 15px;
    color: var(--dark-ink);
    border-bottom: 1px solid var(--dark-line);
    padding-bottom: 3px;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .work__open:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .proof__foot {
    margin: clamp(56px, 8vw, 104px) 0 0;
  }

  .proof__all {
    font-weight: 600;
    font-size: 16px;
    color: var(--dark-ink);
    border-bottom: 1px solid var(--dark-line);
    padding-bottom: 4px;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .proof__all:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ---------- движението ---------- */

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .work__media {
        animation: media-in linear both;
        animation-timeline: view();
        animation-range: entry 6% cover 34%;
      }

      .work__body {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 38%;
      }
    }
  }

  @keyframes media-in {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.965);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .work {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    /* Снимката винаги над текста — редуването няма смисъл в една колона. */
    .work:nth-child(even) .work__media {
      order: 0;
    }
  }
</style>
