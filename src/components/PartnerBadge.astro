---
import { localeOf } from '../i18n/index.ts';
import { owner } from '../i18n/content.ts';
interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'dark' } = Astro.props;
const isLight = variant === 'light';
const lang = localeOf(Astro.currentLocale);
const who = owner(lang);
const label = lang === 'en'
  ? `${who.name} — Lovable Certified Partner 2026`
  : `${who.name} — сертифициран партньор на Lovable за 2026 г.`;
---

<div class:list={["partner-badge", { "partner-badge-light": isLight }]}>
  <img
    src={isLight
      ? "/design/technologies/lovable-certified-partner-2026-light.png"
      : "/design/technologies/lovable-certified-partner-2026.png"}
    alt={label}
    width={isLight ? 524 : 522}
    height={isLight ? 178 : 176}
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .partner-badge {
    margin-top: 24px;
    padding: 8px;
    width: 100%;
    max-width: 280px;
    background: #181818;
    border: 1px solid #ffffff26;
    border-radius: 8px;
  }
  .partner-badge-light {
    padding: 0;
    background: transparent;
    border: 0;
  }
  .partner-badge img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
