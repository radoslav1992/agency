---
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.webp';
import { SITE } from '../data/site.mjs';
import { hasTranslation, href as localised, localeOf, pathForLocale } from '../i18n/index.ts';
import { cta, nav, ui } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const NAV = nav(lang);
const CTA = cta(lang);

const path = Astro.url.pathname;
/** Сравнява без езиковия префикс, за да работи и на двата езика. */
const bare = path.replace(/^\/en(?=\/|$)/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? bare === '/' : !href.startsWith('/#') && bare.startsWith(href);

/*
 * Анализаторът, блогът и /research ги няма на английски. Оттам
 * превключвателят води към началната страница на другия език, вместо към
 * 404 — а надписът го казва, за да не изглежда като счупена връзка.
 */
const other = lang === 'bg' ? 'en' : 'bg';
const paired = hasTranslation(path);
const switchTo = {
  href: paired ? pathForLocale(path, other) : `${other === 'en' ? '/en/' : '/'}`,
  label: other === 'en' ? 'EN' : 'BG',
};
const switchLabel = other === 'en'
  ? (paired ? 'Switch to English' : 'This page is Bulgarian only — go to the English home page')
  : (paired ? 'Смени на български' : 'Тази страница я има само на английски — към българската начална');
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localised('/', lang)} aria-label={`${SITE.name} — ${t.header.home}`}>
      {/* Марката е декоративна: името на студиото стои като текст веднага
          след нея, а линкът си има aria-label. */}
      <Image
        class="brand__mark"
        src={logoMark}
        alt=""
        widths={[30, 60, 90]}
        sizes="30px"
        loading="eager"
      />
      <span class="brand__name">{SITE.shortName}</span>
      <span class="brand__suffix">{SITE.suffix}</span>
    </a>

    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t.header.open}
      data-open-label={t.header.open}
      data-close-label={t.header.close}
      data-nav-toggle
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label={t.header.nav}>
      {
        NAV.map((item) => (
          <a
            class="nav__link"
            href={localised(item.href, lang)}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      {/* Езикът стои до основното действие — най-търсеното място, а и не
          конкурира навигацията за внимание. */}
      <a class="nav__lang" href={switchTo.href} hreflang={other} aria-label={switchLabel}>
        {switchTo.label}
      </a>
      <a
        class="nav__cta"
        href={localised(CTA.href, lang)}
        aria-current={isCurrent(CTA.href) ? 'page' : undefined}
      >
        {CTA.label}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(246, 243, 238, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    padding-block: 16px;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    color: var(--ink);
  }

  .brand:hover {
    color: var(--ink);
  }

  /* Логото си носи заобления квадрат и цвета — тук само размерът. */
  .brand__mark {
    width: 30px;
    height: 30px;
    flex: none;
    display: block;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .brand__suffix {
    font-size: 13px;
    color: var(--ink-subtle);
    margin-left: 2px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 15px;
    font-weight: 500;
  }

  .nav__link {
    color: var(--ink-body);
    transition: color 0.16s ease;
  }

  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--ink);
  }

  .nav__lang {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 6px 11px;
    transition:
      border-color 0.16s ease,
      color 0.16s ease;
  }

  .nav__lang:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .nav__cta {
    background: var(--ink);
    color: var(--bg);
    padding: 10px 18px;
    border-radius: 999px;
    font-weight: 600;
    transition: background-color 0.18s ease;
  }

  .nav__cta:hover {
    background: var(--accent);
    color: #fff;
  }

  /* ---- mobile ---- */

  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    cursor: pointer;
  }

  .burger span {
    display: block;
    width: 18px;
    height: 2px;
    margin-inline: auto;
    background: var(--ink);
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .bar {
      gap: 16px;
      flex-wrap: wrap;
    }

    .burger {
      display: flex;
    }

    .nav {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      padding-block: 8px 4px;
      font-size: 16px;
    }

    .nav[data-open] {
      display: flex;
    }

    .nav__link {
      padding: 12px 4px;
      border-top: 1px solid var(--line);
    }

    .nav__cta {
      margin-top: 10px;
      text-align: center;
      padding: 14px 18px;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');

  if (toggle && nav) {
    // Надписите идват от разметката, за да са на езика на страницата.
    const openLabel = toggle.dataset.openLabel ?? 'Отвори менюто';
    const closeLabel = toggle.dataset.closeLabel ?? 'Затвори менюто';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
      nav.toggleAttribute('data-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close after tapping a link (same-page anchors don't reload).
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Reset when resizing back to desktop so the menu can't stay stuck open.
    const desktop = window.matchMedia('(min-width: 861px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
