---
import { Image } from "astro:assets";
import portrait from "../assets/hero-portrait.png";
import { href as localised, localeOf } from "../i18n/index.ts";
import { owner } from "../i18n/content.ts";
const lang = localeOf(Astro.currentLocale);
const en = lang === "en";
const who = owner(lang);
const lines = en
  ? ["Less routine.", "More room", "to grow."]
  : ["По-малко", "рутина.", "Повече растеж."];
---

<section class="sa-hero" aria-labelledby="hero-title">
  <div class="container sa-hero__grid">
    <div class="sa-hero__copy">
      <p class="sa-kicker sa-hero__intro">
        <span class="sa-mini-star" aria-hidden="true">
          ✳
        </span>{" "}
        {en
          ? "INDEPENDENT DIGITAL & AI STUDIO"
          : "ДИГИТАЛНО СТУДИО ЗА САЙТОВЕ И AI"}
      </p>
      <h1 id="hero-title" aria-label={lines.join(" ")} class="sa-hero__title">
        {lines.map((line, i) => (
          <span class="sa-title-line">
            <span style={`--line:${i}`}>{line}</span>
          </span>
        ))}
      </h1>
      <div class="sa-hero__bottom">
        <svg
          class="sa-scribble"
          width="70"
          height="96"
          viewBox="0 0 70 96"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M8 2c55 3 63 51 32 48S7 5 34 24c22 15 21 46 2 63m-1-22 1 23 22-6"
            stroke="currentColor"
            stroke-width="2"
          />
        </svg>
        <div>
          <p class="sa-hero__lead">
            {en
              ? "Websites that turn visits into conversations. AI agents and automations that take the routine off your hands."
              : "Сайтове, които превръщат посещенията в разговори. AI агенти и автоматизации, които поемат рутината вместо теб."}
          </p>
          <div class="sa-hero__actions">
            <a
              class="sa-button sa-button--dark"
              href={localised("/booking/", lang)}
            >
              {en ? "Let’s talk" : "Да поговорим"}{" "}
              <span aria-hidden="true">↗</span>
            </a>
            <a class="sa-text-link" href={localised("/projects/", lang)}>
              {en ? "Our work" : "Виж проектите"}{" "}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="sa-hero__note">
            {en
              ? "A free first conversation. Directly with the engineer."
              : "Безплатен първи разговор. Директно с инженера."}
          </p>
        </div>
      </div>
    </div>
    <div class="sa-hero__visual">
      <div class="sa-portrait" data-sa-tilt>
        <div class="sa-portrait__circle"></div>
        <Image
          src={portrait}
          alt={who.name}
          widths={[440, 660, 880]}
          sizes="(max-width: 760px) 90vw, 45vw"
          loading="eager"
          fetchpriority="high"
          class="sa-portrait__image"
        />
        <a class="sa-portrait__badge" href="#about">
          <span class="sa-badge-arrow" aria-hidden="true">
            ↗
          </span>
          <span>
            <strong>{who.name}</strong>
            <small>
              {en
                ? "Founder · Software & AI engineer"
                : "Основател · Софтуерен и AI инженер"}
            </small>
          </span>
        </a>
      </div>
      <div class="sa-hero__geometry" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
      <span class="sa-orbit" aria-hidden="true">
        ✳
      </span>
      <p class="sa-hero__location">
        {en
          ? "BASED IN SOFIA. BUILT FOR YOUR BUSINESS."
          : "ОТ СОФИЯ. ЗА ТВОЯ БИЗНЕС."}
      </p>
    </div>
  </div>
  <img
    class="sa-hero__corner"
    src="/design/aleric/hero-corner.svg"
    alt=""
    width="300"
    height="300"
  />
</section>
