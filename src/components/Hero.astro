---
/**
 * Първото движение. Заглавието влиза на етапи при зареждане (по часовник,
 * не по скрол — то е над сгъвката и никой не скролва до него).
 *
 * Посланието е същото, което вече работеше. Промени се мащабът: заглавието
 * е двойно по-едро, а всичко останало отстъпва под него. Портретът остава —
 * „работиш с мен, не с акаунт мениджър“ е обещание, което трудно се вярва
 * на сайт без лице.
 */
import { Image } from 'astro:assets';
import heroPortrait from '../assets/hero-portrait.png';
import { SITE } from '../data/site.mjs';
import { href as localised, localeOf } from '../i18n/index.ts';
import { owner, ui } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const who = owner(lang);
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      {
        SITE.availability && (
          <p class="availability stagger" style="--s: 0">
            <span class="availability__dot" aria-hidden="true" />
            {SITE.availability}
          </p>
        )
      }

      <h1 class="hero__title stagger" style="--s: 1">
        {t.hero.titleLead} <span class="accent">{t.hero.titleAccent}</span>.
      </h1>

      {/* „Готови агенти“ + „по мярка“ нарочно заедно: каталогът отдолу продава
          пакетираните, но вътрешните системи не са агенти и не бива да изпаднат. */}
      <p class="hero__lead stagger" style="--s: 2">{t.hero.lead}</p>

      <div class="hero__actions stagger" style="--s: 3">
        <a class="btn btn--primary" href={localised('/contact/', lang)}>{t.hero.ctaPrimary}</a>
        <a class="btn btn--outline" href={localised('/services/', lang)}>{t.hero.ctaSecondary}</a>
      </div>

      <p class="hero__subnote stagger" style="--s: 4">{t.hero.subnote}</p>

      {/* Анализаторът съществува само на български, затова редът към него се
          показва само там. */}
      {
        t.hero.analyzerQ && (
          <p class="hero__analyzer stagger" style="--s: 5">
            {t.hero.analyzerQ} <a href="/analyzer/">{t.hero.analyzerA}</a>
          </p>
        )
      }
    </div>

    <div class="hero__media stagger" style="--s: 2">
      <div class="hero__blob" aria-hidden="true"></div>
      <Image
        class="hero__image"
        src={heroPortrait}
        alt={who.name}
        widths={[380, 560, 780]}
        sizes="(max-width: 900px) 70vw, 380px"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__badge">
        <p class="hero__badge-name">{who.name}</p>
        <p class="hero__badge-role">{who.role}</p>
      </div>
    </div>
  </div>

  <ul class="hero__facts container stagger" style="--s: 6">
    {t.hero.facts.map((fact) => <li>{fact}</li>)}
  </ul>
</section>

<style>
  .hero {
    padding-block: clamp(48px, 7vw, 96px) 0;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 22px;
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .availability__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    flex: none;
  }

  /*
   * Размерът се мери спрямо КОЛОНАТА, не спрямо екрана — затова `cqw`, а не
   * `vw`. Най-дългата българска дума („Автоматизирам“) иска цялата ширина на
   * колоната; при `vw` тя се чупеше на „Автоматизира / м“ на всяка ширина
   * над 900px. Ограничението важи с още по-голяма сила сега, когато
   * заглавието е с една трета по-едро.
   */
  .hero__copy {
    container-type: inline-size;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 8.4cqw, 76px);
    line-height: 1.01;
    letter-spacing: -0.045em;
    margin: 0;
    /* Клапан за екрани под 340px; над тях не се задейства. */
    overflow-wrap: break-word;
  }

  .accent {
    color: var(--accent);
  }

  .hero__lead {
    font-size: clamp(17px, 1.8vw, 20px);
    line-height: 1.55;
    color: var(--ink-body);
    max-width: 46ch;
    margin: 26px 0 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .hero__subnote {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-subtle);
    margin: 14px 0 0;
    max-width: 48ch;
  }

  .hero__analyzer {
    font-size: 15px;
    margin: 24px 0 0;
    color: var(--ink-body);
  }

  .hero__analyzer a {
    font-weight: 600;
    color: var(--accent);
    border-bottom: 1px solid var(--accent-soft);
    padding-bottom: 2px;
    transition: border-color 0.18s ease;
  }

  .hero__analyzer a:hover {
    border-color: var(--accent);
  }

  /* ---------- портретът ---------- */

  .hero__media {
    position: relative;
    min-width: 0;
  }

  .hero__blob {
    position: absolute;
    inset: 12% -6% -2% 4%;
    background: var(--bg-blush);
    border-radius: 28px;
  }

  .hero__image {
    position: relative;
    width: 100%;
    height: auto;
    display: block;
    filter: var(--shadow-hero);
  }

  .hero__badge {
    position: absolute;
    left: -12px;
    bottom: 14px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 10px 14px;
    box-shadow: var(--shadow-card);
  }

  .hero__badge-name {
    font-weight: 700;
    font-size: 13.5px;
    margin: 0;
  }

  .hero__badge-role {
    font-size: 12px;
    color: var(--ink-muted);
    margin: 2px 0 0;
  }

  /* ---------- лентата с обещанията ---------- */

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px clamp(24px, 4vw, 52px);
    margin: clamp(40px, 6vw, 72px) auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: 14.5px;
    color: var(--ink-muted);
  }

  /* ---------- влизането ---------- */

  .stagger {
    animation: hero-in 0.62s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--s) * 70ms);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .hero__media {
      order: -1;
      max-width: 300px;
    }

    .hero__lead,
    .hero__subnote {
      max-width: none;
    }

    .hero__badge {
      left: 0;
    }
  }
</style>
