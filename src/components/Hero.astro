---
/**
 * Първото движение. Заглавието влиза на етапи при зареждане (по часовник,
 * не по скрол — то е над сгъвката и никой не скролва до него).
 *
 * Посланието е същото, което вече работеше. Промени се мащабът: заглавието
 * заема цялата ширина, а всичко останало отстъпва под него.
 *
 * Портретът СЛЕЗЕ от голямата снимка вдясно до кръгче до обещанието. Лицето
 * не се маха — „работиш с мен, не с акаунт мениджър“ трудно се вярва на сайт
 * без лице, а купувачът тук е малка фирма, която първо проверява дали насреща
 * има истински човек. Но голямата снимка отговаряше на „кой“, докато
 * читателят още пита „какво“, и делеше вниманието със заглавието.
 *
 * Сега лицето стои точно там, където е нужно: подписва изречението „ако
 * процесът ти не става за автоматизация, ще ти го кажа“. Обещание с име и
 * лице тежи повече от портрет, който плава встрани от текста.
 */
import { Image } from 'astro:assets';
import heroPortrait from '../assets/hero-portrait.png';
import { SITE } from '../data/site.mjs';
import { href as localised, localeOf } from '../i18n/index.ts';
import { owner, ui } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const who = owner(lang);
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      {
        SITE.availability && (
          <p class="availability stagger" style="--s: 0">
            <span class="availability__dot" aria-hidden="true" />
            {SITE.availability}
          </p>
        )
      }

      <h1 class="hero__title stagger" style="--s: 1">
        {t.hero.titleLead} <span class="accent">{t.hero.titleAccent}</span>.
      </h1>

      {/* „Готови агенти“ + „по мярка“ нарочно заедно: каталогът отдолу продава
          пакетираните, но вътрешните системи не са агенти и не бива да изпаднат. */}
      <p class="hero__lead stagger" style="--s: 2">{t.hero.lead}</p>

      <div class="hero__actions stagger" style="--s: 3">
        <a class="btn btn--primary" href={localised('/contact/', lang)}>{t.hero.ctaPrimary}</a>
        <a class="btn btn--outline" href={localised('/services/', lang)}>{t.hero.ctaSecondary}</a>
      </div>

      {/* Обещанието и човекът, който го дава — в един блок нарочно. */}
      <div class="promise stagger" style="--s: 4">
        <span class="promise__avatar">
          <Image
            class="promise__face"
            src={heroPortrait}
            alt={who.name}
            widths={[128, 224, 336]}
            sizes="112px"
            loading="eager"
            fetchpriority="high"
          />
        </span>
        <p class="promise__text">
          {t.hero.subnote}
          <span class="promise__who">
            <strong>{who.name}</strong> · {who.role}
          </span>
        </p>
      </div>


      {/* Анализаторът съществува само на български, затова редът към него се
          показва само там. */}
      {
        t.hero.analyzerQ && (
          <p class="hero__analyzer stagger" style="--s: 5">
            {t.hero.analyzerQ} <a href="/analyzer/">{t.hero.analyzerA}</a>
          </p>
        )
      }
    </div>
  </div>

  <ul class="hero__facts container stagger" style="--s: 6">
    {t.hero.facts.map((fact) => <li>{fact}</li>)}
  </ul>
</section>

<style>
  .hero {
    padding-block: clamp(48px, 7vw, 96px) 0;
  }

  /* Една колона: заглавието взима цялата ширина, нищо не се бори с него. */
  .hero__inner {
    display: block;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 22px;
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .availability__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    flex: none;
  }

  /*
   * Размерът се мери спрямо КОНТЕЙНЕРА, не спрямо екрана — затова `cqw`, а
   * не `vw`. Най-дългата българска дума („Автоматизирам“) иска цялата
   * ширина; при `vw` тя се чупеше на „Автоматизира / м“ над 900px.
   */
  .hero__copy {
    container-type: inline-size;
  }

  .hero__title {
    font-family: var(--font-display);
    /* Колоната вече е цялата ширина, затова коефициентът пада — иначе
       заглавието опира тавана още при 900px и спира да расте. */
    font-size: clamp(28px, 6.6cqw, 80px);
    line-height: 1.01;
    letter-spacing: -0.045em;
    margin: 0;
    /* Клапан за екрани под 340px; над тях не се задейства. */
    overflow-wrap: break-word;
  }

  .accent {
    color: var(--accent);
  }

  .hero__lead {
    font-size: clamp(17px, 1.8vw, 20px);
    line-height: 1.55;
    color: var(--ink-body);
    max-width: 46ch;
    margin: 26px 0 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  /* ---------- обещанието и лицето зад него ---------- */

  .promise {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 22px 0 0;
    max-width: 52ch;
  }

  /*
   * Изворът е квадратен портрет до кръста: лицето заема горната трета и е
   * леко вдясно от центъра. `object-fit: cover` върху квадрат показва
   * ЦЕЛИЯ кадър, тоест в кръгчето лицето излиза колкото копче, а под него
   * стои риза.
   *
   * Затова снимката е двойно по-голяма от рамката и е изместена така, че
   * точката (60%, 28%) от кадъра — центърът на лицето — да падне в центъра
   * на кръга. Видимият прозорец става горната половина: глава и рамене.
   */
  .promise__avatar {
    position: relative;
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-blush);
    border: 1px solid var(--line);
  }

  .promise__face {
    position: absolute;
    width: 200%;
    height: auto;
    left: -70%;
    top: -6%;
    /* Глобалното `img { max-width: 100% }` иначе свива тези 200% обратно до
       ширината на рамката и от кадъра остава само едно рамо. */
    max-width: none;
  }

  .promise__text {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-subtle);
    margin: 0;
  }

  .promise__who {
    display: block;
    margin-top: 4px;
    color: var(--ink-muted);
  }

  .promise__who strong {
    color: var(--ink);
    font-weight: 600;
  }

  .hero__analyzer {
    font-size: 15px;
    margin: 24px 0 0;
    color: var(--ink-body);
  }

  .hero__analyzer a {
    font-weight: 600;
    color: var(--accent);
    border-bottom: 1px solid var(--accent-soft);
    padding-bottom: 2px;
    transition: border-color 0.18s ease;
  }

  .hero__analyzer a:hover {
    border-color: var(--accent);
  }

  /* ---------- лентата с обещанията ---------- */

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px clamp(24px, 4vw, 52px);
    margin: clamp(40px, 6vw, 72px) auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: 14.5px;
    color: var(--ink-muted);
  }

  /* ---------- влизането ---------- */

  .stagger {
    animation: hero-in 0.62s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--s) * 70ms);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .hero__lead,
    .promise {
      max-width: none;
    }
  }

  /* Под 380px кръгчето и двата реда текст до него не се събират в редица. */
  @media (max-width: 380px) {
    .promise {
      align-items: flex-start;
      gap: 12px;
    }

    .promise__avatar {
      width: 46px;
      height: 46px;
    }
  }
</style>
