---
import { EXPERIENCE } from '../data/content.ts';
---

<section class="strip">
  <div class="container inner">
    <p class="label">Опит:</p>
    <ul class="items">
      {EXPERIENCE.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .strip {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg-sand);
  }

  .inner {
    padding-block: 22px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 40px;
    font-size: 14px;
    color: var(--ink-muted);
  }

  .label {
    margin: 0;
    font-weight: 600;
    color: var(--ink);
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
