---
/**
 * Гласовият агент на ElevenLabs — плаващото балонче долу вдясно.
 *
 * Сайтът продава агенти, които вдигат телефона. Най-краткото доказателство,
 * че работят, е посетителят да поговори с един от тях, преди да е писал на
 * никого — същата логика, по която анализаторът стои безплатен и без
 * регистрация.
 *
 * ⚠️ Скриптът им НЕ се зарежда със страницата. Тегли се чак при първото
 * докосване, натискане на клавиш или скрол. Две причини:
 *
 *   • Скорост. Приставката е стотици килобайти, а ще я ползва малцинство.
 *     Заредена наготово, тя утежнява първото показване на ВСЕКИ посетител —
 *     точно предимството, заради което на този сайт няма GSAP и Three.js.
 *   • Поверителност. Докато никой не е посегнал към страницата, към
 *     ElevenLabs не заминава нито една заявка. Ботовете и хората, които
 *     затварят веднага, не се свързват с трета страна изобщо.
 *
 * Микрофонът иска `Permissions-Policy: microphone=(self)` — виж
 * `public/_headers`. При затворено разрешение приставката се зарежда,
 * изглежда наред и не чува нищо.
 *
 * ⚠️ Източникът е пакетът `@elevenlabs/convai-widget-embed` през unpkg —
 * този, който ElevenLabs дават за вграждане. Адресът
 * `elevenlabs.io/convai-widget/index.js` е по-старата сглобка на
 * приставката и ѝ липсват по-новите режими, включително текстовият чат.
 * Не го подменяй заради това, че е „на техния домейн“.
 */
import { SITE } from '../data/site.mjs';
import { localeOf } from '../i18n/index.ts';

const lang = localeOf(Astro.currentLocale);

/*
 * Само на български и само с настроен идентификатор. Агентът говори
 * български; приставка, която отговаря на друг език от този на страницата,
 * е по-лоша от липсваща — по същата причина анализаторът и блогът не се
 * показват на `/en/`.
 */
const show = Boolean(SITE.voiceAgentId) && lang === 'bg';

/*
 * ⚠️ Никакви коментари ВЪТРЕ в тага отдолу. Потребителският елемент минава
 * през HTML-разбора на Astro, не през JSX, и всяка дума от коментара се
 * превръща в отделно свойство — `Официално="true"`, `свойство="true"` и
 * така нататък. Обясненията стоят тук.
 *
 * ⚠️ И никакви измислени свойства. Приставката чете строго определен
 * списък и подминава всичко останало МЪЛЧАЛИВО — без предупреждение в
 * конзолата, без нищо. Заради това тук известно време стояха осем
 * несъществуващи свойства, които не правеха абсолютно нищо:
 * `disable-banner` и седем от рода на `start-call-text`.
 *
 * Истинският списък се чете от самия пакет:
 *   npm pack @elevenlabs/convai-widget-embed
 *   grep -o "pg(\`[a-z0-9-]*\`)" package/dist/index.js | sort -u
 *
 * Надписите НЕ се подават оттук. Приставката ги търси по реда:
 *   свойство `text-contents` → предварителните набори по език от таблото →
 *   `text_contents` от таблото → английските по подразбиране.
 * Свойството бие всичко, тоест зададено тук то ЗАГЛУШАВА преводите,
 * писани в таблото — редакциите там просто спират да се появяват, без
 * никакъв признак защо. Преводите се водят на едно място и то е таблото:
 * там има и набори по език, и не иска пускане на сайта наново.
 *
 * Подписът „Powered by ElevenLabs“ НЕ се маха оттук. В кода на приставката
 * той виси на `config.disable_banner`, а тази конфигурация идва от сървъра
 * на ElevenLabs — тоест от таблото и от плана, не от разметката.
 */

/*
 * Цветовете на кълбото.
 *
 * ⚠️ Шестнайсетичните стойности са ПРЕПИСАНИ от `--accent` и
 * `--accent-darker` в `global.css`, а не взети оттам. Приставката живее в
 * shadow DOM и не вижда нашите променливи; свойството ѝ приема само готов
 * цвят. Смени ли се палитрата, тези два реда се сменят на ръка — затова
 * стоят с име, а не разпръснати из разметката.
 */
const ORB = { from: '#e2542b', to: '#b93b16' };

/*
 * Марката за аватара на балончето.
 *
 * Адресът е АБСОЛЮТЕН нарочно. Приставката подава стойността направо като
 * източник на картинка от собствения си контекст, а относителен път би се
 * връзвал за страницата, на която стои — тоест би се чупил при преглед от
 * друг хост. Файлът е част от сайта отдавна (`public/icon-192.png`) и стои
 * на канoничния домейн независимо откъде се гледа приставката.
 *
 * Цветовете на кълбото остават заедно с картинката: приставката ги ползва
 * на различни места в различните си състояния и така, каквото и да покаже,
 * то е в цветовете на марката.
 */
const AVATAR = `${SITE.url}/icon-192.png`;

---

{
  show && (
    <elevenlabs-convai
      agent-id={SITE.voiceAgentId}
      allow-events="true"
      avatar-image-url={AVATAR}
      avatar-orb-color-1={ORB.from}
      avatar-orb-color-2={ORB.to}
      text-input="true"
      data-voice-agent
      data-src="https://unpkg.com/@elevenlabs/convai-widget-embed"
    />
  )
}

<script>
  /*
   * Две задачи: да не тегли скрипта на ElevenLabs, преди някой да е посегнал
   * към страницата, и да отваря балончето, когато в каталога натиснат
   * „Говори с него сега“.
   *
   * Отварянето минава през събитие, което самата приставка слуша върху
   * `document`:
   *   elevenlabs-agent:expand   { action: 'expand' | 'collapse' | 'toggle' }
   *   elevenlabs-agent:contextual-update  { message }
   * Второто иска `allow-events` върху елемента и казва на агента какво
   * гледа човекът, без да прекъсва разговора.
   *
   * Имената не са предположени — прочетени са от пакета:
   *   npm pack @elevenlabs/convai-widget-embed
   *   grep -o "elevenlabs-agent:[a-z-]*" package/dist/index.js | sort -u
   */
  const host = document.querySelector<HTMLElement>('[data-voice-agent]');
  const src = host?.dataset.src;

  if (host && src) {
    /** Първото истинско посягане към страницата — тогава и само тогава. */
    const TRIGGERS = ['pointerdown', 'keydown', 'touchstart', 'scroll'] as const;

    /** Пази скрипта да се тегли веднъж, дори бутонът да се натисне пет пъти. */
    let loading: Promise<void> | null = null;

    const load = () => {
      if (loading) return loading;
      TRIGGERS.forEach((event) => window.removeEventListener(event, load));
      loading = new Promise<void>((resolve, reject) => {
        const already = document.querySelector(`script[src="${src}"]`);
        if (already) return resolve();
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.addEventListener('load', () => resolve());
        script.addEventListener('error', () => reject(new Error('ElevenLabs widget failed to load')));
        document.head.appendChild(script);
      });
      return loading;
    };

    TRIGGERS.forEach((event) =>
      window.addEventListener(event, load, { once: true, passive: true }),
    );

    /*
     * Бутоните „говори с него сега“ от каталога. Слуша се на `document`,
     * за да няма връзка между двата компонента — каталогът само маркира
     * бутон, а приставката знае как да се отвори.
     */
    document.addEventListener('click', async (event) => {
      const trigger = (event.target as Element | null)?.closest<HTMLElement>(
        '[data-open-voice-agent]',
      );
      if (!trigger) return;
      event.preventDefault();

      try {
        await load();
        /* Скриптът може да е зареден, но елементът още да не е дефиниран.
           Таймаут, за да не виси обещанието вечно, ако нещо се обърка. */
        await Promise.race([
          customElements.whenDefined('elevenlabs-convai'),
          new Promise((_, no) => setTimeout(() => no(new Error('timeout')), 8000)),
        ]);
        /* Два кадъра: единият дефинира елемента, другият го монтира. */
        await new Promise((done) =>
          requestAnimationFrame(() => requestAnimationFrame(done)),
        );

        document.dispatchEvent(
          new CustomEvent('elevenlabs-agent:expand', { detail: { action: 'expand' } }),
        );

        const context = trigger.dataset.agentContext;
        if (context) {
          document.dispatchEvent(
            new CustomEvent('elevenlabs-agent:contextual-update', {
              detail: { message: context },
            }),
          );
        }
      } catch {
        /* Приставката е недостъпна — блокирана, офлайн, каквото и да е.
           Балончето просто не се отваря; страницата остава здрава. */
      }
    });
  }
</script>
