---
/**
 * Знакът на марката — обикновен `<img>`, нарочно извън `astro:assets`.
 *
 * Логото стои в хедъра и футъра, тоест на ВСЯКА страница, включително
 * `/booking/`, която се смята при заявка. А `<Image>` на страница, която не
 * се предрендерира, не може да оптимизира нищо при build — вместо готов файл
 * извежда адрес към крайния маршрут `/_image?href=…`. Този маршрут прави:
 *
 *     const proxied = new URL(href, ctx.url.origin);
 *     return fetch(proxied);
 *
 * тоест Worker-ът вика САМ СЕБЕ СИ през ръба. Локално минава, на Cloudflare
 * не — затова логото беше счупено само в продукция и само на `/booking/`.
 * Дефект, който никой build и никоя проверка на типовете не хваща, защото
 * HTML-ът е валиден; счупен е чак адресът вътре в него.
 *
 * Оттук и файлът в `public/`: сервира се като статичен ресурс, еднакво на
 * предрендерирана и на изчислена при заявка страница, без междинен маршрут.
 *
 * 96 пиксела покриват трите места, на които се показва — 30, 26 и 38 —
 * с запас за екрани с двойна плътност. Целият файл е 3.5 KB; през `/_image`
 * се теглеше оригиналът от 258 KB, за да се покаже на 30 пиксела.
 *
 * ⚠️ Името е фиксирано, значи няма хеш и няма автоматично разваляне на кеша.
 * Смениш ли логото, смени и числото в името или изчисти кеша, иначе
 * браузърите ще показват старото до седмица (`/brand/*` в `public/_headers`).
 *
 * Файлът се пресъздава от изходния 512×512 със:
 *
 *     node -e "require('sharp')('src/assets/brand/logo-mark.webp')
 *       .resize(96, 96).webp({ quality: 92 })
 *       .toFile('public/brand/logo-mark-96.webp')"
 */
interface Props {
  /** Страната на квадрата в CSS пиксели. */
  size: number;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { size, class: className, loading = 'lazy' } = Astro.props;
---

<img
  class={className}
  src="/brand/logo-mark-96.webp"
  alt=""
  width={size}
  height={size}
  loading={loading}
  decoding="async"
/>
