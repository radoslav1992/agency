---
import { SITE } from '../data/site.mjs';
---

<section class="cta container">
  <div class="panel">
    <div>
      <h2 class="panel__title">Имаш процес, който яде твърде много време?</h2>
      <p class="panel__lead">
        Разкажи ми как върви в момента. Ще ти кажа дали може да се автоматизира и откъде е
        разумно да се започне. Ако не съм подходящият човек, ще ти го кажа още в разговора.
      </p>
    </div>
    <div class="panel__actions">
      <a class="action action--ink" href="/contact/">Запази безплатен разговор</a>
      <a class="action action--ghost" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <p class="panel__subnote">30 минути. Не се иска подготовка — покажи ми процеса както си е.</p>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: 0 96px;
  }

  .panel {
    background: var(--accent);
    color: #fff;
    border-radius: 32px;
    padding: 64px 56px;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: center;
  }

  .panel__title {
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.1;
    margin: 0;
    color: #fff;
  }

  .panel__lead {
    font-size: 18px;
    line-height: 1.55;
    margin: 18px 0 0;
    color: var(--accent-soft);
    max-width: 460px;
  }

  .panel__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .action {
    padding: 16px 26px;
    border-radius: 999px;
    font-weight: 600;
    text-align: center;
    color: #fff;
    transition:
      background-color 0.18s ease,
      color 0.18s ease;
    word-break: break-word;
  }

  .action--ink {
    background: var(--ink);
  }

  .action--ink:hover {
    background: #000;
    color: #fff;
  }

  .action--ghost {
    background: rgba(255, 255, 255, 0.15);
  }

  .action--ghost:hover {
    background: rgba(255, 255, 255, 0.26);
    color: #fff;
  }

  .panel__subnote {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--accent-soft);
    margin: 2px 0 0;
    text-align: center;
  }

  @media (max-width: 860px) {
    .cta {
      padding-bottom: 64px;
    }

    .panel {
      grid-template-columns: 1fr;
      padding: 40px 28px;
      border-radius: 26px;
      gap: 28px;
    }
  }
</style>
