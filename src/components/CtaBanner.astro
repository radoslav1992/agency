---
/**
 * Последното движение. Панелът се разгъва при влизане в екрана — ъглите се
 * изправят, а мащабът се изравнява — така страницата свършва с жест, а не
 * просто с още една карта.
 *
 * Съдържанието не е променяно: същият въпрос, същото обещание, същият
 * директен имейл. Само мащабът е друг.
 */
import { SITE } from '../data/site.mjs';
import { href as localised, localeOf } from '../i18n/index.ts';
import { ui } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
---

<section class="cta">
  <div class="container">
    <div class="panel">
      <div class="panel__copy">
        <h2 class="panel__title">{t.cta.title}</h2>
        <p class="panel__lead">{t.cta.body}</p>
      </div>

      <div class="panel__actions">
        <a class="action action--ink" href={localised('/contact/', lang)}>{t.cta.button}</a>
        <a class="action action--ghost" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <p class="panel__subnote">{t.cta.note}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(64px, 9vw, 112px) clamp(72px, 10vw, 120px);
  }

  .panel {
    background: var(--accent);
    color: #fff;
    border-radius: 36px;
    padding: clamp(40px, 6vw, 84px) clamp(28px, 4.5vw, 72px);
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(32px, 4vw, 56px);
    align-items: center;
    /* Базовото състояние е крайното — без анимация панелът просто стои. */
    transform: none;
  }

  .panel__copy {
    container-type: inline-size;
  }

  .panel__title {
    font-family: var(--font-display);
    font-size: clamp(27px, 7.5cqw, 56px);
    line-height: 1.04;
    letter-spacing: -0.04em;
    margin: 0;
    color: #fff;
  }

  .panel__lead {
    font-size: 17.5px;
    line-height: 1.55;
    margin: 22px 0 0;
    color: var(--accent-soft);
    max-width: 48ch;
  }

  .panel__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .action {
    padding: 17px 28px;
    border-radius: 999px;
    font-weight: 600;
    text-align: center;
    color: #fff;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      transform 0.18s ease;
    word-break: break-word;
  }

  .action--ink {
    background: var(--ink);
  }

  .action--ink:hover {
    background: #000;
    color: #fff;
    transform: translateY(-2px);
  }

  .action--ghost {
    background: rgba(255, 255, 255, 0.15);
  }

  .action--ghost:hover {
    background: rgba(255, 255, 255, 0.26);
    color: #fff;
  }

  .panel__subnote {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--accent-soft);
    margin: 2px 0 0;
    text-align: center;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .panel {
        animation: unfold linear both;
        animation-timeline: view();
        animation-range: entry 8% cover 42%;
      }
    }
  }

  @keyframes unfold {
    from {
      transform: scale(0.93);
      border-radius: 72px;
      opacity: 0.55;
    }
    to {
      transform: none;
      border-radius: 36px;
      opacity: 1;
    }
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
      padding: 34px 24px;
      border-radius: 26px;
      gap: 28px;
    }

    .panel__lead {
      max-width: none;
    }

    /* Същата анимация, по-плитка — на телефон едрият завой изглежда като
       дефект, а не като жест. */
    @keyframes unfold {
      from {
        transform: scale(0.95);
        border-radius: 44px;
        opacity: 0.6;
      }
      to {
        transform: none;
        border-radius: 26px;
        opacity: 1;
      }
    }
  }
</style>
