---
import { href as localised, localeOf } from '../i18n/index';
const lang = localeOf(Astro.currentLocale);
const {
  section = lang === 'en' ? 'Kova Studio' : 'Кова студио',
  parentHref,
  parentLabel,
} = Astro.props;
---

<header class="al-template al-page-hero">
  <div class="container">
    <nav class="al-breadcrumb" aria-label={lang === 'en' ? 'Breadcrumb' : 'Навигационна пътека'}>
      <a href={localised('/', lang)}>{lang === 'en' ? 'Home' : 'Начало'}</a>
      <span aria-hidden="true">/</span>
      {parentHref && (
        <>
          <a href={parentHref}>{parentLabel}</a>
          <span aria-hidden="true">/</span>
        </>
      )}
      <span aria-current="page">{section}</span>
    </nav>
    <div class="al-page-hero__grid">
      <div>
        <p class="al-section-label">
          <slot name="eyebrow">{section}</slot>
        </p>
        <h1 class="al-page-title" data-al-reveal>
          <slot name="title" />
        </h1>
      </div>
      <div class="al-page-hero__aside">
        {Astro.slots.has('lead') && (
          <div class="al-page-lead">
            <slot name="lead" />
          </div>
        )}
        {Astro.slots.has('meta') && (
          <div class="al-page-meta">
            <slot name="meta" />
          </div>
        )}
        <span class="al-page-arrow" aria-hidden="true">
          ↙
        </span>
      </div>
    </div>
    <span class="al-measure al-measure--wide" aria-hidden="true"></span>
  </div>
</header>
