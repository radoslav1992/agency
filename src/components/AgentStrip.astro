---
import { AGENTS, AGENTS_ON_HOME } from '../data/agents.ts';

/**
 * Лента с готовите агенти, веднага след hero-а.
 *
 * Нарочно НЕ е въртяща се карусел: авто-въртенето скрива всичко след първия
 * елемент (малцина натискат стрелките), бута заглавието надолу и вреди на
 * скоростта. Тук всички карти са достъпни — на тесен екран лентата се
 * плъзга с пръст, на широк се събира цялата.
 */
const shown = AGENTS.slice(0, AGENTS_ON_HOME);
---

<section class="strip" aria-labelledby="agents-strip-title">
  <div class="container">
    <div class="strip__head">
      <h2 class="strip__title" id="agents-strip-title">Готови AI агенти</h2>
      <a class="strip__link" href="/agents/">Всички {AGENTS.length} агента →</a>
    </div>

    <ul class="rail">
      {
        shown.map((agent) => (
          <li class="card">
            <a href={`/agents/#${agent.id}`}>
              <span class="card__channel">{agent.channel}</span>
              <span class="card__name">{agent.name}</span>
              <span class="card__short">{agent.short}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .strip {
    border-top: 1px solid var(--line);
    background: var(--bg-sand);
    padding-block: 26px 30px;
  }

  .strip__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .strip__title {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }

  .strip__link {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }

  /* Плъзгаща се лента: всичко е достъпно, нищо не се крие зад таймер. */
  .rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 1fr);
    gap: 12px;
    margin: 0;
    padding: 0 0 4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .card {
    scroll-snap-align: start;
  }

  .card a {
    display: flex;
    flex-direction: column;
    gap: 5px;
    height: 100%;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 16px 18px;
    color: inherit;
    transition:
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .card a:hover {
    border-color: var(--accent);
    color: inherit;
    transform: translateY(-2px);
  }

  .card__channel {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card__name {
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
  }

  .card__short {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  @media (max-width: 680px) {
    .rail {
      grid-auto-columns: minmax(220px, 78%);
    }
  }
</style>
