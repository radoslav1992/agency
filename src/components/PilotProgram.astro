---
/** Пилотната програма — една секция, без повторение при цените. */
import { href as localised, localeOf } from '../i18n/index.ts';
import { ui } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
---

<section class="pilot-wrap container">
  <div class="pilot">
    <div>
      <p class="eyebrow">{t.pilot.eyebrow}</p>
      <h2 class="pilot__title">{t.pilot.title}</h2>
      <p class="pilot__text">
        {t.pilot.body}
      </p>
      <p class="pilot__text">
        {t.pilot.note}
      </p>
    </div>
    <a class="btn btn--primary pilot__cta" href={localised('/contact/', lang)}>{t.pilot.cta}</a>
  </div>
</section>

<style>
  .pilot-wrap {
    padding-block: 64px 0;
  }

  .pilot {
    background: var(--bg-sand);
    border: 1px solid var(--accent);
    border-radius: 24px;
    padding: 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .pilot__title {
    font-size: clamp(24px, 4vw, 32px);
    letter-spacing: -0.03em;
    margin: 8px 0 14px;
  }

  .pilot__text {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-body);
    margin: 0 0 10px;
    max-width: 640px;
  }

  .pilot__cta {
    /* `none` пази бутона от свиване до текста си, докато стои до абзаца. */
    flex: none;
    /* …но на телефон надписът е по-широк от екрана и изтласкваше страницата
       настрани. Таванът го оставя да се пренесе на два реда вместо това. */
    max-width: 100%;
  }

  @media (max-width: 680px) {
    .pilot-wrap {
      padding-block: 48px 0;
    }

    .pilot {
      padding: 26px 22px;
    }
  }
</style>
