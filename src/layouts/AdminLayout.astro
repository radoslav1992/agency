---
/**
 * Обвивка само за панела.
 *
 * Нарочно НЕ ползва `BaseLayout`: там влизат хедърът, футърът, банерът за
 * бисквитки, гласовият агент и Google Analytics. На административна страница
 * банер за съгласие е безсмислен, гласовият агент — също, а посещенията ти в
 * панела нямат работа в статистиката на сайта.
 */
import '@fontsource-variable/onest';
import '../styles/global.css';
import '../styles/startup.css';
import '../styles/inner-pages.css';
import BrandMark from '../components/BrandMark.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Кова студио</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon-32.png" type="image/png" />
  </head>
  <body class="admin sa-site sa-admin">
    <header class="sa-admin-bar">
      <a href="/">
        <BrandMark size={38} loading="eager" />
        <strong>Кова студио</strong>
      </a>
      <span>Управление на разговорите</span>
    </header>
    <main class="admin__main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body.admin {
    background: var(--bg-sand);
  }

  .admin__main {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(32px, 5vw, 64px) 20px clamp(60px, 8vw, 100px);
  }
</style>
